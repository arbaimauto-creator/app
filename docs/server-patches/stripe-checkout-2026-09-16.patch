+// Stripe Checkout 세션 검증 후 결제 문서 생성 (2026-09-16).
+// PayPal 경로(createPayPalNew)와 같은 원칙: 서버가 결제사에 직접 조회해 확인하고, 중복 처리와 금액 불일치를 막는다.
+paymentSchema.statics.createStripeNew = async function (params, session = undefined) {
+  const Payment = this;
+  const sessionId = params.stripeData && params.stripeData.sessionId;
+  if (!sessionId) {
+    throw { errorMsg: 'stripe session id is missing' };
+  }
+
+  const exist = await Payment.find({ 'stripe.id': sessionId });
+  if (exist && exist.length > 0) {
+    throw { errorMsg: 'The payment is already processed.' };
+  }
+
+  const stripe = require('stripe')(process.env.STRIPE_SECRET_KEY);
+  const checkout = await stripe.checkout.sessions.retrieve(sessionId);
+
+  if (checkout.payment_status !== 'paid') {
+    throw { errorMsg: 'Cannot verify the checkout on Stripe.' };
+  }
+  if (String(checkout.metadata && checkout.metadata.orderId) !== String(params.order._id)) {
+    throw { errorMsg: 'The checkout does not belong to this order.' };
+  }
+
+  // KRW는 소수 없는 통화라 amount_total이 원 단위 그대로다. 다른 통화면 최소 단위(센트)로 온다.
+  const zeroDecimal = String(checkout.currency).toLowerCase() === 'krw';
+  const paidAmount = zeroDecimal ? Number(checkout.amount_total) : Number(checkout.amount_total) / 100;
+  const expected = zeroDecimal
+    ? Number(params.order.totalPrice)
+    : Number(Utils.changeCurrencySync(params.order.totalPrice, 'KRW'));
+
+  // 환율 반올림 오차 허용치(1 단위). KRW면 정확히 일치해야 한다.
+  const tolerance = zeroDecimal ? 0 : 1;
+  if (Math.abs(paidAmount - expected) > tolerance) {
+    throw { errorMsg: 'The purchase amount is not equal to checkout data at Stripe' };
+  }
+
+  const paymentCommissionRate = Const.COMMISSION_RATE.PG_STRIPE;
+  const paymentCommissionAmount = parseInt(
+    Const.COMMISSION_RATE.PG_STRIPE * Number(params.order.totalPrice),
+  );
+
+  const payment = {
+    stripe: {
+      id: checkout.id,
+      paymentIntent: checkout.payment_intent,
+      currency: checkout.currency,
+      amountTotal: checkout.amount_total,
+      customerEmail: checkout.customer_details && checkout.customer_details.email,
+    },
+    PAY_GROUP: 'STRIPE',
+    PAY_METHOD: 'CARD',
+    TID: checkout.payment_intent || checkout.id,
+    order: params.order._id,
+    cartItems: params.order.cartItems.map((cart) => cart._id),
+    buyer: params.order.buyer._id,
+    seller: params.order.seller._id,
+    paymentCommissionRate,
+    paymentCommissionAmount,
+    statusCode: Const.PAY_STATUS_CODE.PAID,
+  };
+
+  return new Payment(payment).save({ session });
+};
