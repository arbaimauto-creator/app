9c\uc758 7~10%\ub97c \ud574\ub2f9 \ub9ac\ubdf0\uc5b4\uc5d0\uac8c \ud604\uae08\uc73c\ub85c \uc9c0\uae09\ud569\ub2c8\ub2e4.',STORE_SUBTITLE_3:'Yes, Best Price! \ucd5c\uc800\uac00 \uc57d\uc18d \uc0c1\ud488',STORE_BODY_3:'\ud2b9\ubcc4 \ud560\uc778 \uc0c1\ud488\uc740 \ubc18\ub4dc\uc2dc \uad6c\ub9e4\ud558\uc138\uc694! \uadf8\ub808\uc774\ub4dc\uac00 \uc628\ub77c\uc778 \ucd5c\uc800\uac00\ub97c \uc57d\uc18d\ud569\ub2c8\ub2e4.',GO_TO_EVENT:'\uc774\ubca4\ud2b8 \ucc38\uc5ec\ud558\uae30',GO_TO_EVENT_DESCRIPTION:'(\ubc84\ud2bc \ud074\ub9ad\uc73c\ub85c \uc774\ubca4\ud2b8 \ucc38\uc5ec)',TERMS_URL:{PRIVACY_POLICY:'https://greyd.app/static/terms_privacy_policy_kor.txt',PRIVACY_POLICY_FOR_SELLER:'https://greyd.app/static/privacy_policy_of_seller_kor.txt',DIGITAL_FINANCE:'https://greyd.app/static/terms_digital_finance_kor.txt',BUYER:'https://greyd.app/static/terms_for_buyer_kor.txt',SELLER:'https://greyd.app/static/terms_for_seller_kor.txt',SERVICE:'https://greyd.app/static/service_terms_kor.txt',GREYDER:'https://greyd.app/static/service_terms_kor.txt'},EVENT_COMPLETE_NOTICE1:'\uccab \ubc88\uc9f8 \uc774\ubca4\ud2b8\uc5d0\n\ucc38\uc5ec\uc644\ub8cc \ub418\uc5c8\uc2b5\ub2c8\ub2e4.',EVENT_COMPLETE_NOTICE2:'\ub450 \ubc88\uc9f8 \uc774\ubca4\ud2b8\uc5d0\n\ucc38\uc5ec\uc644\ub8cc \ub418\uc5c8\uc2b5\ub2c8\ub2e4.',EVENT_PAGE_TITLE1:'greyd \uacbd\ud488 \uc774\ubca4\ud2b8',EVENT_PAGE_WARNING:'\uc774\ubca4\ud2b8 \uc8fc\uc758\uc0ac\ud56d',EVENT_NOTICE_STRING1:'\ub2f9\ucca8\uc790\ub294 \ubb34\uc791\uc704 \ucd94\ucca8\uc2dc\uc2a4\ud15c \uc0ac\uc6a9\uc744 \uc6d0\uce59\uc73c\ub85c \ud569\ub2c8\ub2e4.',EVENT_NOTICE_STRING2:'\uc81c\uacf5\ubc1b\ub294 \uacbd\ud488\uc740 \ub2f9\ucca8\uc790\uc758 \uac1c\uc778\uc0ac\uc815\uc5d0 \uc758\ud55c \ud0c0 \uc0c1\ud488\uc73c\ub85c \uad50\ud658 \ubc0f \ud658\ubd88\uc774 \ubd88\uac00\ud569\ub2c8\ub2e4.',EVENT_NOTICE_STRING3:'\uc218\uc9d1\ub41c \uac1c\uc778\uc815\ubcf4\ub294 \uacbd\ud488 \ubc1c\uc1a1\uc73c\ub85c\ub9cc \uc0ac\uc6a9\ub418\uba70 \uadf8\ub808\uc774\ub4dc\ub294 \uc774\ubca4\ud2b8 \ucc38\uc5ec\ud655\uc778, \uacbd\ud488\ubc1c\uc1a1, \uace0\uac1d\uc751\ub300 \ub4f1\uc758 \ud65c\ub3d9\ubaa9\uc801\uc5d0 \ud55c\ud574, \ub2f9\uc0ac\uc790\uc758 \ub3d9\uc758\ub97c \uc5bb\uc740 \ud6c4 \uac1c\uc778\uc815\ubcf4\ub97c \uc218\uc9d1\ud569\ub2c8\ub2e4.',EVENT_NOTICE_STRING4:'5\ub9cc\uc6d0\uc774\uc0c1 \uacbd\ud488 \ub2f9\ucca8 \uc2dc \uc81c\uc138\uacf5\uacfc\uae08 \ubcf8\uc778\ubd80\ub2f4',EVENT_NOTICE_STRING5:'\uace0\uac1d\uc758 \uac1c\uc778\uc815\ubcf4\ub294 \uc6d0\uce59\uc801\uc73c\ub85c \uac1c\uc778\uc815\ubcf4\uc758 \uc218\uc9d1 \ubc0f \uc774\uc6a9\ubaa9\uc801\uc774 \ub2ec\uc131\ub41c \ud6c4, \ub0b4\ubd80 \ubc29\uce68 \ubc0f \uae30\ud0c0 \uad00\ub828 \ubc95\ub839\uc5d0 \uc758\ud55c \uc815\ubcf4\ubcf4\ud638 \uc0ac\uc720\uc5d0 \ub530\ub77c \ucd5c\ub300 1\uac1c\uc6d4\uac04 \uc800\uc7a5\ub41c \ud6c4 \ud30c\uae30\ub429\ub2c8\ub2e4.',EVENT_NOTICE_STRING6:'\uadf8\ub808\uc774\ub4dc\uc5d0\uc11c \uc9c4\ud589\ud558\ub294 \uc774\ubca4\ud2b8\ub85c \ub2e4\ub978 \uc5c5\uccb4\uc640\ub294 \uc5f0\uad00\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.',USER_PHONE:'\ud734\ub300\uc804\ud654',USER_EMAIL:'\uc0ac\uc6a9\uc790 \uc774\uba54\uc77c',CHECK_USER_ID:'\uc544\uc774\ub514 \ud615\uc2dd\uc744 \ud655\uc778\ud574\uc8fc\uc138\uc694.',CHECK_USER_EMAIL:'\uc774\uba54\uc77c \ud615\uc2dd\uc744 \ud655\uc778\ud574\uc8fc\uc138\uc694.',CHECK_USER_PHONE:'\ud734\ub300\uc804\ud654 \ubc88\ud638\ub97c \ud655\uc778\ud574\uc8fc\uc138\uc694.',CONDITION_USER_EMAIL:'\uc774\uba54\uc77c\uc744 \uc785\ub825\ud574\uc8fc\uc138\uc694.',CONDITION_USER_PHONE:'\ud734\ub300\uc804\ud654 \ubc88\ud638\ub97c \uc785\ub825\ud574\uc8fc\uc138\uc694.',WRITTEN_REVIEW_EXIST:'\uc774\uc804\uc5d0 \uc791\uc131\ud588\ub358 \ub9ac\ubdf0\uac00 \ub0a8\uc544\uc788\uc2b5\ub2c8\ub2e4',SURE_TO_RESTORE_REVIEW:'\ubcf5\uc6d0\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?',RESTORE:'\ubcf5\uc6d0',WRITE_NEW_REVIEW:'\uc0c8\ub85c\uc791\uc131',SURE_TO_EXIT_WRITTING_REVIEW:'\ub9ac\ubdf0 \uc791\uc131\uc744 \uc885\ub8cc\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?',CAN_RESTORE_REVIEW:'\uc791\uc131 \uc911\uc778 \ub9ac\ubdf0\ub294 \uc774\ud6c4 \ub2e4\uc2dc \ubd88\ub7ec\uc62c \uc218 \uc788\uc2b5\ub2c8\ub2e4.',CANT_LOAD_VIDEO_TRY_AGAIN:'\ube44\ub514\uc624\ub97c \ubd88\ub7ec\uc62c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ube44\ub514\uc624\ub97c \uc0ad\uc81c\ud558\uace0 \ub2e4\uc2dc \uc120\ud0dd\ud574\uc8fc\uc138\uc694.',CANT_LOAD_VIDEO_CHECK:'\ube44\ub514\uc624\ub97c \ubd88\ub7ec\uc62c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \ud655\uc778\ud574\uc8fc\uc138\uc694.',LOADING_VIDEO_WAIT:'\ube44\ub514\uc624\ub97c \ubd88\ub7ec\uc624\ub294 \uc911\uc785\ub2c8\ub2e4. \uc7a0\uc2dc\ub9cc \uae30\ub2e4\ub824\uc8fc\uc138\uc694.',COURIER_SELECTION:'\ud0dd\ubc30\uc0ac \uc120\ud0dd',COURIER_NUMBER:'\uc6b4\uc1a1\uc7a5\ubc88\ud638(-\uc81c\uc678)',COURIER_SELECTION_GUIDE:'\ud0dd\ubc30\uc0ac\ub97c \uc120\ud0dd\ud574\uc8fc\uc138\uc694',COURIER_OTHERS:'\uae30\ud0c0',LOGIN_FAILED:'\ub85c\uadf8\uc778\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4.',MORE_REVIEW_BUTTON1:'\ud0ed\ud558\uc5ec \ub354 \ub9ce\uc740',MORE_REVIEW_BUTTON2:'\ub9ac\ubdf0 \ud655\uc778\ud558\uae30',MORE_PRODUCT_BUTTON1:'\ud0ed\ud558\uc5ec \ub354 \ub9ce\uc740',MORE_PRODUCT_BUTTON2:'\uc0c1\ud488 \ud655\uc778\ud558\uae30',CODEPUSH_UPDATE_INSTALLED:'\uc5c5\ub370\uc774\ud2b8\uac00 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4.',CODEPUSH_INSTALLING_UPDATE:'\uc5c5\ub370\uc774\ud2b8\ub97c \uc124\uce58 \uc911\uc785\ub2c8\ub2e4.',CODEPUSH_DOWNLOADING_PACKAGE:'\uc5c5\ub370\uc774\ud2b8\ub97c \ub2e4\uc6b4\ub85c\ub4dc \uc911\uc785\ub2c8\ub2e4.',CODEPUSH_UP_TO_DATE:'\ucd5c\uc2e0 \ubc84\uc804\uc785\ub2c8\ub2e4.',CODEPUSH_CHECKING_FOR_UPDATE:'\uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778 \uc911\uc785\ub2c8\ub2e4.',CODEPUSH_UPDATE_FAILED:'\uc5c5\ub370\uc774\ud2b8\uc5d0 \uc2e4\ud328\ud558\uc600\uc2b5\ub2c8\ub2e4.',REGISTER_GREYDER:'\uadf8\ub808\uc774\ub354\ub85c \ub4f1\ub85d',MESSAGE_NEED_ALL_AGREEMENT_TO_REGISTER_GREYDER:'\ub9ac\uc6cc\ub4dc \uc815\uc0b0\uc740 \uadf8\ub808\uc774\ub354 \uc11c\ube44\uc2a4 \uc57d\uad00 \ub3d9\uc758\uac00 \ud544\uc694\ud569\ub2c8\ub2e4.',EMPTY_NOTIFICATION_MESSAGE:'\uc0c8\ub85c\uc6b4 \uc54c\ub9bc\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.',CASH_OUT:'\uc815\uc0b0\ud558\uae30',AVAILABLE_BALANCE:'\uc815\uc0b0 \uac00\ub2a5 \uae08\uc561',REWARD_SETTLEMENT:'\ub9ac\uc6cc\ub4dc \uc815\uc0b0',REQUEST_REWARD_WITHDRAWAL:'\ub9ac\uc6cc\ub4dc \ucd9c\uae08 \uc2e0\uccad',REQUEST_REWARD_WITHDRAWAL_GUIDE1:"'+' \ubc84\ud2bc\uc744 \ud074\ub9ad\ud558\uc5ec",REQUEST_REWARD_WITHDRAWAL_GUIDE2:'\ub9ac\uc6cc\ub4dc\ub97c \ud604\uae08\uc73c\ub85c \uad50\ud658\ud558\uc138\uc694.',SETTLEMENT_IN_PROCESS:'\uc815\uc0b0 \ucc98\ub9ac \uc911\uc785\ub2c8\ub2e4.',SETTLEMENT_ACCOUNT:function(E){return`${E}\ub2d8 \uacc4\uc88c`},SETTLEMENT_IN_PROCESS_GUIDE2:'\uc785\uae08 \uc608\uc815\uc785\ub2c8\ub2e4.',WITHDRAWAL_AMOUNT:'\ucd9c\uae08 \uae08\uc561',ENTER_WITHDRAWAL_AMOUNT:'\ucd9c\uae08 \uae08\uc561\uc744 \uc785\ub825\ud574\uc8fc\uc138\uc694.',WITHDRAWAL_GUIDE_MORE_AMOUNT:function(E){return`${E} \uc774\uc0c1\uc758 \uae08\uc561\uc744 \ucd9c\uae08 \uac00\ub2a5\ud569\ub2c8\ub2e4.`},WITHDRAWAL_GUIDE_EXCESS_AMOUNT:'\ucd9c\uae08 \uac00\ub2a5\ud55c \uae08\uc561\uc744 \ucd08\uacfc\ud558\uc600\uc2b5\ub2c8\ub2e4.',WITHDRAWAL_GUIDE_CHECK_AGAIN:'\ub2e4\uc2dc \ud655\uc778\ud574\uc8fc\uc138\uc694.',WITHDRAWAL_GUIDE_FAILED:'\ub9ac\uc6cc\ub4dc \ucd9c\uae08 \uc2e0\uccad\uc5d0 \uc2e4\ud328\ud558\uc600\uc2b5\ub2c8\ub2e4.',WITHDRAWAL_GUIDE_CHECK_INFO:'\uc785\ub825 \uc815\ubcf4\ub97c \ud655\uc778\ud574\uc8fc\uc138\uc694.',WITHDRAWAL_GUIDE_CHECK_LICENSE_INFO:'\uc5d0\uc774\uc804\uc2dc \uc0ac\uc5c5\uc790\ub4f1\ub85d\uc99d\uc744 \ucca8\ubd80\ud574\uc8fc\uc138\uc694.',WITHDRAWAL_REQUEST_GUIDE:function(E){return`${E} \uc774\uc0c1\uc758 \ub9ac\uc6cc\ub4dc\ub97c \ud604\uae08\uc73c\ub85c \uad50\ud658 \uac00\ub2a5\ud569\ub2c8\ub2e4.`},AGREE_OF_GREYDER_SERVICE:'\uadf8\ub808\uc774\ub354 \uc11c\ube44\uc2a4 \ub3d9\uc758',NO_AGREEMENT_ALL_TO_REWARD_SETTLEMENT:'\ub9ac\uc6cc\ub4dc \uc815\uc0b0\uc744 \uc704\ud574 \ubaa8\ub4e0