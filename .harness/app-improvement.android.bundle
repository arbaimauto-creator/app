DETAIL_MESSAGE:function(E){return`${E.productTitle} - ${E.percentage}%\uac00 \uc801\uc6a9\ub418\uc5b4 ${E.discountAmount}\uc6d0 \ud560\uc778`},SIGN_IN_AND_CHECK_LOWEST_PRICE:'\ub85c\uadf8\uc778\ud558\uace0 \ucd5c\uc800\uac00\ud655\uc778',PAY_METHODS:'\uacb0\uc81c \uc218\ub2e8',CREDIT_CARD:'\uc2e0\uc6a9 \uce74\ub4dc',KAKAO_PAY_CREDIT_CARD:'\uce74\uce74\uc624\ud398\uc774 \uc2e0\uc6a9\uce74\ub4dc',KAKAO_PAY_MONEY:'\uce74\uce74\uc624\ud398\uc774 \uba38\ub2c8',NAVER_PAY_CREDIT_CARD:'\ub124\uc774\ubc84\ud398\uc774 \uc2e0\uc6a9\uce74\ub4dc',NAVER_PAY_POINT:'\ub124\uc774\ubc84\ud398\uc774 \ud3ec\uc778\ud2b8',ORDER_PURCHASE_ALARM_TO_REVIEWER_TITLE:function(E){return`\ucd95\ud558\ud574\uc694! ${E.eventMakerId.name}\ub2d8\uc774 \ub2f9\uc2e0\uc758 \ub9ac\ubdf0\ub97c \ubcf4\uace0 \uad6c\ub9e4\ud588\uc5b4\uc694`},ORDER_PURCHASE_ALARM_TO_REVIEWER_BODY:function(E){return`${E.eventMakerId.name}\ub2d8\uc774 \ub2f9\uc2e0\uc758 \ub9ac\ubdf0 "${E.videoId.title.ko}"\ub97c \ubcf4\uace0 "${E.productId.title.ko?E.productId.title.ko:E.productId.title}" \uc0c1\ud488\uc744 \uad6c\ub9e4\ud588\uc5b4\uc694!`},SIGN_IN_WITH_KAKAO:'\uce74\uce74\uc624\ub85c \uacc4\uc18d\ud558\uae30',SIGN_IN_WITH_FACEBOOK:'Facebook\uc73c\ub85c \uacc4\uc18d\ud558\uae30',SIGN_IN_WITH_GOOGLE:'Google\ub85c \uacc4\uc18d\ud558\uae30',SIGN_IN_WITH_APPLE:'Apple\ub85c \uacc4\uc18d\ud558\uae30',SIGN_IN_WITH_GUEST:'\ud68c\uc6d0\uac00\uc785 \uc5c6\uc774 \ub458\ub7ec\ubcf4\uae30',QUESTION_TO_REVIEWER:'\ub9ac\ubdf0\uc5b4\uc5d0\uac8c \uc9c1\uc811 \ubb3c\uc5b4\ubcf4\uae30',BASE_SCORE_TITLE:'5\uc810\uc740 \uae30\ubcf8 \uc810\uc218\uc785\ub2c8\ub2e4.',BASE_SCORE_CONTENT:'\uc815\ub9d0 \uae30\ubcf8 \uc810\uc218\ub97c \uc8fc\uc2dc\uaca0\uc2b5\ub2c8\uae4c?',SECRET_COMMENT:'\ube44\ubc00 \ub313\uae00',REWARD_GUIDE:'\ub9ac\uc6cc\ub4dc \uac00\uc774\ub4dc',ACCUMULATED_REWARD:'\ub204\uc801 \ub9ac\uc6cc\ub4dc',WITHDRAWAL_STATUS:{REQUESTED:'\uc694\uccad\ub428',ACCEPTED:'\uc218\ub77d\ub428',FINISHED:'\uc644\ub8cc\ub428',REJECTED:'\uac70\uc808\ub428