'You were invited for a reason.',OB_2_LABEL:'\uad6c\uc870',OB_2_HEAD:'\ud55c\uad6d\uc5d0\uc11c \uc2e4\uc81c \uc81c\ud488\uc774 \ubc30\uc1a1\ub429\ub2c8\ub2e4.\n\uc804 \uacfc\uc815 \ucd94\uc801.',OB_2_NOTE:'\ud83d\udce6 Ships from Seoul in 3\u20135 days. Tracking included.',OB_2_SUB:'Real products from Korea. Shipped to your door, tracked.',OB_3_LABEL:'\uac80\uc99d \ub8e8\ud504',OB_3_HEAD:"\ub2f9\uc2e0\uc758 \uc194\uc9c1\ud55c \ubc18\uc751\uc744\n\ube0c\ub79c\ub4dc\uac00 \uc9c1\uc811 \ud3c9\uac00\ud569\ub2c8\ub2e4.\ngreyd\uc758 'grade'\uc8e0.",OB_3_SUB:"Your honest take gets graded by the brand \u2014 that's the 'grade' in greyd.",OB_4_LABEL:'\uccab \ud589\ub3d9',OB_4_HEAD:'\uccab \ucea0\ud398\uc778\uc744 \uace0\ub974\uc138\uc694.',OB_4_SPOTS:'\uc774\ubc88 \uc8fc 12\uc790\ub9ac \ub0a8\uc74c',OB_4_SUB:'Pick your first campaign. 12 spots left this week.',OB_CTA:'\ud504\ub85c\ud544 \uc644\uc131\ud558\uace0 \uc2dc\uc791 \xb7 +50P',INVITE_GATE_TITLE:'\ub2f9\uc2e0\uc774 \ucd08\ub300\ub41c \ub370\ub294\n\uc774\uc720\uac00 \uc788\uc2b5\ub2c8\ub2e4',INVITE_GATE_SUBTITLE:'\ucd08\ub300 \ucf54\ub4dc\ub97c \uc785\ub825\ud558\uace0 greyd \ud328\ub110\uc5d0 \ud569\ub958\ud558\uc138\uc694',INVITE_CODE_PLACEHOLDER:'6\uc790\ub9ac \ucf54\ub4dc',INVITE_CODE_FORMAT_ERROR:'6\uc790\ub9ac \ucd08\ub300 \ucf54\ub4dc\ub97c \uc785\ub825\ud574\uc8fc\uc138\uc694',INVITE_CODE_INVALID:'\uc720\ud6a8\ud558\uc9c0 \uc54a\uc740 \ucf54\ub4dc\uc608\uc694. \ucd08\ub300\ud574 \uc900 \uc0ac\ub78c\uc5d0\uac8c \ucf54\ub4dc\ub97c \ub2e4\uc2dc \uc694\uccad\ud574\uc8fc\uc138\uc694.',INVITE_VERIFY_TIMEOUT:'\ud655\uc778\uc774 \uc9c0\uc5f0\ub418\uace0 \uc788\uc5b4\uc694. \ub124\ud2b8\uc6cc\ud06c\ub97c \ud655\uc778\ud558\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574\uc8fc\uc138\uc694.',INVITE_THROTTLED:function(E){return`\uc2dc\ub3c4\uac00 \ub108\ubb34 \ub9ce\uc558\uc5b4\uc694. ${E}\ucd08 \ud6c4\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud574\uc8fc\uc138\uc694.`},INVITE_BRAND_WEB_ONLY:'\ube0c\ub79c\ub4dc \ud30c\ud2b8\ub108\ub294 \uc6f