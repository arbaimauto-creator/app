NOTICE_FORWARD:'Do not show again',GO_TO_CHECK:'Go to check',GREYD_GUIDELINES:'Cannot change grade once submitted',NOTIFICATIONS_TITLE:'Notifications',BLOCKED_ACCOUNT:'Blocked Account',UNBLOCK:'Unblock',UNBLOCKED:'Unblocked',BLOCK_SOMEONE_QUESTION:function(E){return`Do you want to block ${E.userName}?`},UNBLOCK_SOMEONE_QUESTION:function(E){return`Do you want to unblock ${E.userName}?`},BLOCK_GUIDELINES:function(E){return`You no longer check posts of ${E.userName}.`},BLOCK_SOMEONE_COMPLETE:function(E){return`You blocked ${E.userName}`},BLOCK_SOMEONE_FAILED:function(E){return`Failed to block ${E.userName}`},BLOCKED_ALREADY:'This account is blocked',UNBLOCKED_ALREADY:'Unblocked account',BLOCK_COMPLETE_GUIDELINES:'You can unblock the other account either from their profile or the Blocked account on My Profile settings.',UNBLOCK_COMPLETE_GUIDELINES:function(E){return`You can check posts of ${E.userName}.`},UNBLOCK_SOMEONE_COMPLETE:function(E){return`You unlocked ${E.userName}`},UNBLOCK_SOMEONE_FAILED:function(E){return`Failed to unblock ${E.userName}`},RETRY_GUIDELINES:'Please try later.',FAILED_TO_LOAD_CART:'Failed to load product list on cart',SELECT_ALL:'Select all',PRODUCT_PRICE:'Product price',A_PRODUCT_AND_OTHERS:function(E){var t=E.title,_=E.otherCount;return 0===_?`${t}`:_>1?`${t} (+ ${_} items)`:`${t} (+ ${_} item)`},GO_TO_HOME:'Go to home',GO_TO_SHOPPING:'Go to shopping',GO_TO_POST_REVIEW:'Go to post a review',REVIEW_FIRST_UPLOADED_GUIDE_TITLE:function(E){return`${E.userName}'s first review has been uploaded!`},REVIEW_FIRST_UPLOADED_GUIDE_BODY:'To reviewers who upload their first review,\ngreyd will give you a coupon as a thank you gift for purchasing our store products!We hope this will help in your next purchase for your next review.',REVENUE_GUIDE_TITLE_1:'greyd reveiwers can earn profits!',REVENUE_GUIDE_BODY_1_1:"If you bought a product on greyd, try uploading a review video on it. Even if it's a simple review video, if it generates sales, 10% of the sales will automatically be deposited to you.",REVENUE_GUIDE_TITLE_2:'You can withdraw your earnings at any time.',REVENUE_GUIDE_BODY_2_1:'When a buyer simply presses the Confirm Purchase button, the earnings are automatically deposited to the reviewer. You can transfer your earnings to your account at any time.',REVENUE_GUIDE_TITLE_3:'Why post reviews on greyd',REVENUE_GUIDE_BODY_3_1:'You can find the great products at affordable prices. The greyd Team offers quality products at reasonable prices directly linked to the app. You can also generate earnings from the reviews you upload.',REVENUE_GUIDE_BODY_3_2:'You can be spotlighted even without many followers. The greyd Team incorporates algorithms that will expose good reviews more often. Reviewers with many followers does not equate to exposure.',REVENUE_GUIDE_BODY_3_3:'Post reviews and earn revenue. The reviews you upload can also generate earnings for you.',REVENUE_GUIDE_BODY_3_4:'Meet great products at affordable prices. Quality products curated by the greyd team of expert MDs, offered at reasonable prices.',GRADE_GIVING_GUIDE:function(E){return`Was this a helpful review?\n${E.userName}, grade this review!`},GRADING_GUIDE_TITLE:'Give your opinion for a review through your grade.',GRADING_GUIDE_BODY_1:'On greyd, you can give a grade of 1 to 10 points.',GRADING_GUIDE_BODY_2:'Reviews with high grades get more opportunities for exposure.',GRADING_GUIDE_BODY_3:'You can check the reliability and integrity of a review through its grade.',GRADING_GUIDE_WARNING:'This message disappears after leaving a score.',TUTORIAL_LANDING_TITLE_1:'Everything is possible on greyd.',TUTORIAL_LANDING_TITLE_2:'Post a revie\nor grade a review.',TUTORIAL_LANDING_TITLE_3:'What products do\nother people buy?',TUTORIAL_LANDING_TITLE_4:'Sell your review\non greyd.\nReal reviews,\ngreyd.',TUTORIAL_LANDING_BODY_1:'Reviewers who post reviews and generate profits\n/Followers who support those reviewers\nEverything is possible.',TUTORIAL_LANDING_BODY_2:"We all contribute to\ngreyd's review culture.",TUTORIAL_LANDING_BODY_3:'You can see what products\nother users recently bought\non your My Page.',TUTORIAL_LANDING_BODY_4:'Go to greyd',TUTORIAL_REVIEW_TITLE_5:'Reviews are\nalways\nwelcome!!',TUTORIAL_REVIEW_BODY_1_1:'On greyd, ',TUTORIAL_REVIEW_BODY_1_2:'your experience\n',TUTORIAL_REVIEW_BODY_1_3:'generate ',TUTORIAL_REVIEW_BODY_1_4:'earnings',TUTORIAL_REVIEW_BODY_2_1:'Film and upload a simple video\nthat is ',TUTORIAL_REVIEW_BODY_2_2:'less than 90 seconds.',TUTORIAL_REVIEW_BODY_3_1:'You earn 10% of the sales\n',TUTORIAL_REVIEW_BODY_3_2:'if the purchase is made on\nthe greyd app.',TUTORIAL_REVIEW_BODY_4_1:'You can also post reviews\nof products you bought\noutside of the greyd store!\n',TUTORIAL_REVIEW_BODY_4_2:'Gain followers who are interested in the products you consume\n',TUTORIAL_REVIEW_BODY_4_3:"(We're planning on gradually increasing the number\nof sellers on the greyd store!)",TUTORIAL_REVIEW_BODY_5_1:'Post your ',TUTORIAL_REVIEW_BODY_5_2:'first review,\n',TUTORIAL_REVIEW_BODY_5_3:'and get ',TUTORIAL_REVIEW_BODY_5_4:'a reward!\n',STORE_TITLE:'greyd\u2019s Store',STORE_SUBTITLE_1:'Yes, Exclusive',STORE_BODY_1:'Our team always work hard to present quality products at lowest price.',STORE_SUBTITLE_2:'Yes, Share',STORE_BODY_2:'The reviewers receive 7~10% of the sales generated by their reviews of the products in the store.',STORE_SUBTITLE_3:'Yes, The lowest prices',STORE_BODY_3:'Our special discount items guaranteed to be the lowest prices on the internet. Buy these special discount products!',TERMS_URL:{PRIVACY_POLICY:'https://greyd.app/static/terms_privacy_policy_eng.txt',PRIVACY_POLICY_FOR_SELLER:'https://greyd.app/static/privacy_policy_of_seller_eng.txt',DIGITAL_FINANCE:'https://greyd.app/static/terms_digital_finance_eng.txt',BUYER:'https://greyd.app/static/terms_for_buyer_eng.txt',SELLER:'https://greyd.app/static/terms_for_seller_eng.txt',SERVICE:'https://greyd.app/static/service_terms_eng.txt',GREYDER:'https://greyd.app/static/service_terms_eng.txt'},GO_TO_EVENT:'Join the Event',GO_TO_EVENT_DESCRIPTION:'(Click to join the event)',EVENT_COMPLETE_NOTICE1:'Event 1.\nCompleted',EVENT_COMPLETE_NOTICE2:'Event 2.\nCompleted',EVENT_PAGE_TITLE1:'greyd Give away Event',EVENT_PAGE_WARNING:'Event notice',EVENT_NOTICE_STRING1:'We randomly choose prize winners through a lottery system.',EVENT_NOTICE_STRING2:'Prizes cannot be exchanged or refunded due to personal circumstances.',EVENT_NOTICE_STRING3:'The collected personal information is used only for sending prizes, and greyd collects personal information for activities such as confirmation of event participation, sending prizes, and customer service only after consent by the individual.',EVENT_NOTICE_STRING4:'If you win a prize of more than 50,000 won, you are responsible for paying the tax and utility fees.',EVENT_NOTICE_STRING5:'In principle, after the purpose of collecting and using personal information is achieved, an individual\u2019s personal information is destroyed after being stored for up to one month according to internal policies and other reasons for information protection under related laws.',EVENT_NOTICE_STRING6:'Apple is not a sponsor.',USER_PHONE:'Phone Number',USER_EMAIL:'User email',CHECK_USER_ID:'Please check ID format.',CHECK_USER_EMAIL:'Please check email format.',CHECK_USER_PHONE:'Please check phone number format.',CONDITION_USER_EMAIL:'Provide e-mail for receiving events and prizes',CONDITION_USER_PHONE:'Please enter phone number.',WRITTEN_REVIEW_EXIST:'There are previous reviews from before.',SURE_TO_RESTORE_REVIEW:'Restore review?',RESTORE:'Restore',WRITE_NEW_REVIEW:'New review',SURE_TO_EXIT_WRITTING_REVIEW:'Exit review?',CAN_RESTORE_REVIEW:'Review can be restored later.',CANT_LOAD_VIDEO_TRY_AGAIN:"Can't load video. Please delete and select again.",CANT_LOAD_VIDEO_CHECK:"Can't load video. Please check again.",LOADING_VIDEO_WAIT:'Loading video. Please wait a moment.',COURIER_SELECTION:'Courier',COURIER_NU