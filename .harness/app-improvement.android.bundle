ION:'Business Certification',VALIDATION_MESSAGE_NO_AVAILABLE_NUMBER_TO_SALE:'Please input number of item to sale',PURCHASE_RULE_BUTTON_LABEL:'Shipping/Exchange/Return',VIEW_COUNT:function(E){return`${E} Views`},MONEY_AMOUNT_UNIT_DOLLOR:function(E){return`$${E}`},MONEY_AMOUNT_UNIT_WON:function(E){return`\uffe6${E}`},HOT_REVIEWER:'Hot Reviewers',FOLLOWER_COUNT:function(E){return`${E} Followers`},FOLLOWING_COUNT:function(E){return`${E} Following`},MYPROFILE_SCREEN_TITLE:'My Profile',SHARE:'Share',UPPER_REVIEW:'Upper review',SECONDS_AGO:function(E){return'right now'},MINUTES_AGO:function(E){return E>1?`${E} minutes ago`:'a minute ago'},HOURS_AGO:function(E){return E>1?`${E} hours ago`:'an hour ago'},DAYS_AGO:function(E){return E>1?`${E} days ago`:'a day ago'},MONTHS_AGO:function(E){return E>1?`${E} months ago`:'a month ago'},YEARS_AGO:function(E){return E>1?`${E} years ago`:'a year ago'},BUY:'Buy',REVIEWS_FOR_PRODUCT:'Reviews for this product',UNCATEGORIZED:'Uncategorized',SELLER_BANK_NAME:'Bank',SELLER_BANK_ACCOUNT:'Bank Account Number',SELLER_BANK_ACCOUNT_HOLDER:"Account Holder's Name",GRADING_REVIEW:'Grading review',REVIEW_LIST:'Reviews',PRODUCT_LIST:'Products',EXCHANGE_AND_RETURN:'Exchange/Return',EXCHANGE_AND_RETURN_PERIOD:'Exchange/Return period',EXCHANGE_AND_RETURN_PERIOD_DESCRIPTION:'\uad50\ud658/\ud658\ubd88 \uc694\uccad\uc740 \ubc30\uc1a1 \uc644\ub8cc \uc2dc\uc810\uc73c\ub85c\ubd80\ud130 7\uc77c \uc774\ub0b4\uc5d0 \uac00\ub2a5\ud569\ub2c8\ub2e4. (\ub2e8, \uc218\ub839\ud55c \uc0c1\ud488\uc774 \ud45c\uae30 \uad11\uace0\uc758 \ub0b4\uc6a9\uacfc \ub2e4\ub974\uac70\ub098 \uacc4\uc57d \ub0b4\uc6a9\uacfc \ub2e4\ub974\uac8c \uc774\ud589\ub41c \uacbd\uc6b0\uc5d0\ub294 \uc218\ub839\ud55c \ub0a0\ub85c\ubd80\ud130 3\uac1c\uc6d4 \uc774\ub0b4, \uadf8 \uc0ac\uc2e4\uc744 \uc54c \uc218 \uc788\uc5c8\ub358 \ub0a0\ub85c\ubd80\ud130 30\uc77c \uc774\ub0b4\uc5d0\ub294 \uad50\ud658/\ud658\ubd88 \uc2e0\uccad \uac00\ub2a5\ud569\ub2c8\ub2e4.)',HOW_TO_EXCHANGE_AND_RETURN:'How to exchange/return',HOW_TO_EXCHANGE_AND_RETURN_DESCRIPTION:'\uad50\ud658 \n1) \uc7a5\ubc14\uad6c\ub2c8 > \ubc30\uc1a1\uc644\ub8cc \ud398\uc774\uc9c0\uc5d0\uc11c \uad50\ud658 \uc694\uccad \n2) \ud0dd\ubc30\uae30\uc0ac \ubc18\ud488 \uc0c1\ud488 \uc218\uac70(\uc77c\ubd80 \ud654\ubd88/\uc124\uce58 \uc0c1\ud488 \uc81c\uc678) OR \ud3b8\uc758\uc810\uc5d0\uc11c \ubc18\ud488 \uc811\uc218 \n- \ud0dd\ubc30\ubc18\ud488: \ud658\ubd88 \uc694\uccad \ud6c4 1~3\uc77c \uc774\ub0b4(\uc8fc\ub9d0/\uacf5\ud734\uc77c \uc81c\uc678)\uc5d0 \uc9c0\uc815 \ud0dd\ubc30\uc0ac \uc9c1\uc6d0 \ub610\ub294 \ud574\ub2f9 \ud310\ub9e4\uc5c5\uccb4\uc5d0\uc11c \uc9c1\uc811 \uc218\uac70\ud569\ub2c8\ub2e4.\n- \ud3b8\uc758\uc810\ubc18\ud488: \uac00\uae4c\uc6b4 \ud3b8\uc758\uc810 (CU, GS25)\uc5d0 \ubc29\ubb38\ud558\uc154\uc11c \uc9c1\uc811 \uc811\uc218\ud574\uc8fc\uc138\uc694.\n3) \uc0c8\uc81c\ud488 \uc7ac\ubc30\uc1a1 \n \n\ud658\ubd88 \n1) \uc7a5\ubc14\uad6c\ub2c8 > \ubc30\uc1a1\uc644\ub8cc \ud398\uc774\uc9c0\uc5d0\uc11c \ud658\ubd88 \uc694\uccad \n2) \ud0dd\ubc30\uae30\uc0ac \ubc18\ud488 \uc0c1\ud488 \uc218\uac70(\uc77c\ubd80 \ud654\ubd88/\uc124\uce58 \uc0c1\ud488 \uc81c\uc678) OR \ud3b8\uc758\uc810\uc5d0\uc11c \ubc18\ud488 \uc811\uc218 \n- \ud0dd\ubc30\ubc18\ud488: \ud658\ubd88 \uc694\uccad \ud6c4 1~3\uc77c \uc774\ub0b4(\uc8fc\ub9d0/\uacf5\ud734\uc77c \uc81c\uc678)\uc5d0 \uc9c0\uc815 \ud0dd\ubc30\uc0ac \uc9c1\uc6d0 \ub610\ub294 \ud574\ub2f9 \ud310\ub9e4\uc5c5\uccb4\uc5d0\uc11c \uc9c1\uc811 \uc218\uac70\ud569\ub2c8\ub2e4. \n- \ud3b8\uc758\uc810\ubc18\ud488: \uac00\uae4c\uc6b4 \ud3b8\uc758\uc810 (CU, GS25)\uc5d0 \ubc29\ubb38\ud558\uc154\uc11c \uc9c1\uc811 \uc811\uc218\ud574\uc8fc\uc138\uc694. \n3) \ud658\ubd88 \ucc98\ub9ac',EXCHANGE_AND_RETURN_SHIPMENT_FEE:'Shipment fee for returning',EXCHANGE_AND_RETURN_SHIPMENT_FEE_DESCRIPTION:'\uad50\ud658 \n5,000\uc6d0 \n\ub3d9\uc77c\uc0c1\ud488 \ubc0f \ub3d9\uc77c \uc635\uc158\uc73c\ub85c\ub9cc \uad50\ud658\uc774 \uac00\ub2a5\ud558\uba70, \ud310\ub9e4\uc790\uadc0\ucc45(\uc81c\ud488\ud558\uc790, \uc624\ubc30\uc1a1 \ub4f1)\uc73c\ub85c \uc694\uccad\ud558\uc168\ub354\ub77c\ub3c4 \uc0c1\ud488\ud655\uc778 \uacb0\uacfc\uc5d0 \ub530\ub77c \ubc30\uc1a1\ube44 \uc785\uae08\uc744 \uc694\uccad\ub4dc\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3c4\uc11c \uc0b0\uac04 \uc9c0\uc5ed \ubc0f \uc124\uce58/\ud574\uc678 \ubc30\uc1a1 \uc0c1\ud488\uc740 \ucd94\uac00 \ube44\uc6a9\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n \n\ud658\ubd88 \n\uc655\ubcf5 5,000\uc6d0 \n\uace0\uac1d \ub2e8\uc21c \ubcc0\uc2ec\uc758 \uacbd\uc6b0\uc5d0\ub9cc \ubc1c\uc0dd\ub418\uba70, \ucd5c\ucd08 \ubc30\uc1a1\ube44 \ubb34\ub8cc\uc778 \uacbd\uc6b0 \uc655\ubcf5\ubc30\uc1a1\ube44 \ucc28\uac10 \ud6c4 \ud658\ubd88\ub429\ub2c8\ub2e4. \n\ub3c4\uc11c \uc0b0\uac04 \uc9c0\uc5ed \ubc0f \uc124\uce58/\ud574\uc678 \ubc30\uc1a1 \uc0c1\ud488\uc740 \ucd94\uac00 \ube44\uc6a9\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',SNS_SIGN_IN:'Sign in with SNS',ARBAIM_INC:'ARBAIM INC.',SURE_TO_CONFIRM_PURCHASE:'Are you sure to confirm purchase?',REQUEST_PERMISSION:'Request permission',PERMISSION_GALLERY_MESSAGE:'This app needs the authority to access gallery to upload image or video.',REJECTED_PERMISSION_GALLERY_MESSAGE:'This function is unavailable for not aquired permission to access gallery. Please allow this app to get the permission on the application settings of device.',YES:'Yes',NO:'No',TEXT_DESCRIPTION:'Text description',IMAGE_DESCRIPTION:'Image description',PRODUCT_IMAGE:'Product image',SHIPMENT_COST:'Shipment Cost',LOWEST_ORDER_PRICE_FOR_FREE_DELIVERY:'Lowest order price for free delivery',CHECKING_UPDATE:'Checking update..',ONBOARING_1_TITLE:'Share your reviews of\n various products and services',ONBOARING_1_MESSAGE:'And get genuine reviews from people',ONBOARING_2_TITLE:'Check product details\n from the link below',ONBOARING_2_MESSAGE:'And purchase products\n directly from the link',ONBOARING_3_TITLE:'Monetize your experience\n on our platform',ONBOARING_3_MESSAGE:'If your review