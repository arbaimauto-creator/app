4\ub974\uba70 \ub354 \ub9ce\uc740 \uc774\ub4e4\uc5d0\uac8c \uc804\ud30c\ub418\uba70 \ub178\ucd9c\ub429\ub2c8\ub2e4.'},GIVER:{CONTENT_1:'\ub2f9\uc2e0\uc740 \uadf8\ub808\uc774\ub4dc \ucd5c\uc0c1\uc704 3%\ub9cc\uc774 \ub2ec\uc131\ud560 \uc218 \uc788\ub294',CONTENT_2:'\uc785\ub2c8\ub2e4.',CONTENT_3:'',CONTENT_4:'\ub294 \uc138\uc0c1\uc5d0 \uac00\uc7a5 \ud30c\uae09\ub825\uc774 \ud06c\uace0 \uc9c4\uc911\ud55c \uc601\ud5a5\ub825\uc744 \ub07c\uce58\ub294 \uadf8\ub808\uc774\ub354\ub85c\uc11c \ubaa8\ub4e0 \uadf8\ub808\uc774\ub354\ub4e4\uc758 \ub9ac\ub354\uc774\uc790 \uc2e0\uc911\ud558\uace0 \uc9c4\uc2e4\ub41c \uadf8\ub808\uc774\ub4dc\ub9cc\uc744 \uc120\ubcf4\uc77c \uc790\uaca9\uc744 \uac16\ucd94\uc5c8\uc2b5\ub2c8\ub2e4.'},ARTISAN:{CONTENT_1:'\ub2f9\uc2e0\uc740 \uadf8\ub808\uc774\ub4dc \ucd5c\uace0 \uc219\ub828\uc790\uc778 \uc7a5\uc778',CONTENT_2:'\uc785\ub2c8\ub2e4.',CONTENT_3:'',CONTENT_4:'\uc740 \uadf8\ub808\uc774\ub354 \ud2f0\uc5b4 5 \ub2e8\uacc4\ub85c Giver \ub2e4\uc74c\uc73c\ub85c \uc138\uc0c1\uc5d0 \ub9c9\ub300\ud558\uace0 \uc9c0\ub300\ud55c \uc601\ud5a5\ub825\uc744 \ub07c\uce58\ub294 \uadf8\ub808\uc774\ub354\uc785\ub2c8\ub2e4. \uc544\ud2f0\uc794\uc5d0 \ub3c4\ub2ec\ud55c \uadf8\ub808\uc774\ub354\ub294 \ubcf8\uc778\uc758 \uadf8\ub808\uc774\ub4dc\uc2dd\uc2a4\ub97c \uac70\uc758 \uc644\ubcbd\ud788 \uad6c\uc0ac\ud560 \uc904 \uc54c\uba70 \uadf8 \ub2a5\ub825\uce58\ub294 \ucd5c\uace0\uc218\uc900\uc5d0 \ub2ec\ud569\ub2c8\ub2e4.'},OPERATOR:{CONTENT_1:'\ub2f9\uc2e0\uc740 \uadf8\ub808\uc774\ub4dc \uace0\uae09\uc790',CONTENT_2:'\uc785\ub2c8\ub2e4.',CONTENT_3:'',CONTENT_4:'\ub294 \uadf8\ub808\uc774\ub354\ub85c\uc11c\uc758 \uc790\uc9c8\uacfc \uc804\ubb38\uc131\uc744 \uac16\ucd98 \uace0\uae09 \uadf8\ub808\uc774\ub354\uc785\ub2c8\ub2e4. \ub9ce\uc740 \ub9ac\ubdf0 \uacbd\ud5d8\uc5d0\uc11c \uc5bb\uc740 \ub178\ud558\uc6b0\ub97c \ubc14\ud0d5\uc73c\ub85c \uadf8\ub4e4\ub9cc\uc758 \ub2e4\uc591\ud558\uace0 \uc9c8 \uc88b\uc740 \ub9ac\ubdf0\ub97c \uc120\ubcf4\uc774\uba70 \uc790\uc720\uc790\uc7ac\ub85c \uc601\uc0c1\uc744 \ub2e4\ub8f0 \uc218 \uc788\ub294 \ub2e8\uacc4\uc785\ub2c8\ub2e4.'},STRIVER:{CONTENT_1:'\ub2f9\uc2e0\uc740 \uadf8\ub808\uc774\ub4dc \uc911\uae09\uc790',CONTENT_2:'\uc785\ub2c8\ub2e4.',CONTENT_3:'',CONTENT_4:'\ub294 \uc2a4\uc2a4\ub85c \ud574\ub0b8 \uc5c5\uc801\uacfc \uc131\uacfc\ub85c \uc778\ud55c \ubcf4\uc0c1\uacfc \uc131\uacf5\uc744 \ubaa9\ud45c\ub85c \ud558\ub294 \uadf8\ub808\uc774\ub354\uc785\ub2c8\ub2e4. \uacbd\uc7c1\uc801\uc774\uace0 \ub3c4\uc804\uc801\uc774\uba70 \ub354 \ud070 \uc601\ud5a5\ub825\uc744 \uc804\ud30c\ud558\uae30 \uc704\ud574 \ub178\ub825\ud558\ub294 \uadf8\ub4e4\uc758 \uc5f4\uc815\uc740 \uadf8 \uc5b4\ub5a4 \uadf8\ub808\uc774\ub354\ub4e4 \ubcf4\ub2e4 \uac15\ud569\ub2c8\ub2e4.'},EXPLORER:{CONTENT_1:'\ub2f9\uc2e0\uc740 \uadf8\ub808\uc774\ub4dc \ucd08\uae09\uc790',CONTENT_2:'\uc785\ub2c8\ub2e4.',CONTENT_3:'',CONTENT_4:'\ub294 \uc218\uc775\uc744 \ubc1b\uc744 \uc218 \uc788\ub294 \uadf8\ub808\uc774\ub354 \ucc9c \ubc88\uc9f8 \ub2e8\uacc4\uc785\ub2c8\ub2e4. \uadf8\ub808\uc774\ub354\ub85c\uc11c \ub2ec\uc131\ud55c \uc5c5\uc801\uc774 \ub9ce\uc9c0 \uc54a\uc73c\uba70 \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud55c \ud0d0\ud5d8\uacfc \uc5f0\uad6c\uac00 \ud544\uc694\ud569\ub2c8\ub2e4. \uadf8\ub808\uc774\ub354\uc758 \uc804\ubb38\uc131\uc744 \ud0a4\uc6b0\uae30 \uc704\ud574 G6 (\uadf8\ub808\uc774\ub4dc\uc2dd\uc2a4)\ub97c \ucc44\uc6cc \ub098\uac00\ubcf4\uc138\uc694.'},PIONEER:{CONTENT_1:'\ub2f9\uc2e0\uc740 \uadf8\ub808\uc774\ub4dc \uc785\ubb38\uc790',CONTENT_2:'\uc785\ub2c8\ub2e4.',CONTENT_3:'',CONTENT_4:'\ub294 \uadf8\ub808\uc774\ub4dc\uc5d0 \ubc29\uae08 \uc785\ubb38\ud55c \uac1c\ucc99\uac00\uc785\ub2c8\ub2e4. \ud50c\ub7ab\ud3fc\uc5d0 \ub300\ud55c \uc774\ud574\uc640 \uac1c\ub150\uc774 \ubd80\uc871\ud55c \ub2e8\uacc4\ub85c \ub3c4\uc6c0\ub9d0\uacfc \uc124\uba85\ub780\uc744 \ucc38\uace0\ud558\uc5ec \uc790\uc2e0\uc5d0\uac8c \uc8fc\uc5b4\uc9c4 \uc5c5\uc801\uc744 \ucc28\uadfc\ucc28\uadfc \uc774\ud589\ud574\ubcf4\uc138\uc694. \ub354 \ud070 \uc5c5\uc801\uc744 \uc644\ub8cc\ud560 \uc218\ub85d \ub354 \ud070 \ubcf4\uc0c1\uc774 \uc8fc\uc5b4\uc9d1\ub2c8\ub2e4.'}},DO_REVIEW:'\ub9ac\ubdf0\ud558\uae30',G_SIX:{AUTHENTIC:'\ud45c\ud604\ub825',INFORMATIVE:'\uc815\ubcf4\uc131',ATTRACTIVE:'\ub9e4\ub825\ub3c4',ENTERTAINING:'\uc7ac\ubbf8',AESTHETIC:'\uc601\uc0c1\ubbf8',CREATIVE:'\ub3c5\ucc3d\uc131'},RATE_G_SIX:'\ud3c9\uac00\ud558\uae30',SCORE_INNER:[{"\ud45c\ud604\ub825":0,"\uc815\ubcf4\uc131":0,"\ub9e4\ub825\ub3c4":0,"\uc7ac\ubbf8":0,"\uc601\uc0c1\ubbf8":0,"\ub3c5\ucc3d\uc131":0},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],SCORE_OUTLINE:[{"\ud45c\ud604\ub825":2,"\uc815\ubcf4\uc131":2,"\ub9e4\ub825\ub3c4":2,"\uc7ac\ubbf8":2,"\uc601\uc0c1\ubbf8":2,"\ub3c5\ucc3d\uc131":2},{"\ud45c\ud604\ub825":4,"\uc815\ubcf4\uc131":4,"\ub9e4\ub825\ub3c4":4,"\uc7ac\ubbf8":4,"\uc601\uc0c1\ubbf8":4,"\ub3c5\ucc3d\uc131":4},{"\ud45c\ud604\ub825":6,"\uc815\ubcf4\uc131":6,"\ub9e4\ub825\ub3c4":6,"\uc7ac\ubbf8":6,"\uc601\uc0c1\ubbf8":6,"\ub3c5\ucc3d\uc131":6},{"\ud45c\ud604\ub825":8,"\uc815\ubcf4\uc131":8,"\ub9e4\ub825\ub3c4":8,"\uc7ac\ubbf8":8,"\uc601\uc0c1\ubbf8":8,"\ub3c5\ucc3d\uc131":8},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],KR:'\uad6d\ub0b4',US:'\ud574\uc678',FREE_SHIPPING:'\ubb34\ub8cc\ubc30\uc1a1 \uac00\ub2a5\uc5ec\ubd80',INPUT_LOWEST_ORDER_PRICE_FOR_FREE_DELIVERY:'\ubb34\ub8cc\ubc30\uc1a1 \ucd5c\uc18c\uae08\uc561\uc744 \uc785\ub825\ud574\uc8fc\uc138\uc694.',SHIPPING_REGION:'\ubc30\uc1a1 \uad6d\uac00',SCORE_AUTHENTIC:[{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":6,"\ub9e4\ub825\ub3c4":6,"\uc7ac\ubbf8":6,"\uc601\uc0c1\ubbf8":6,"\ub3c5\ucc3d\uc131":6},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],SCORE_INFORMATIVE:[{"\ud45c\ud604\ub825":6,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":6,"\uc7ac\ubbf8":6,"\uc601\uc0c1\ubbf8":6,"\ub3c5\ucc3d\uc131":6},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],SCORE_ATTRACTIVE:[{"\ud45c\ud604\ub825":6,"\uc815\ubcf4\uc131":6,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":6,"\uc601\uc0c1\ubbf8":6,"\ub3c5\ucc3d\uc131":6},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],SCORE_ENTERTAINING:[{"\ud45c\ud604\ub825":6,"\uc815\ubcf4\uc131":6,"\ub9e4\ub825\ub3c4":6,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":6,"\ub3c5\ucc3d\uc131":6},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],SCORE_AESTHETIC:[{"\ud45c\ud604\ub825":6,"\uc815\ubcf4\uc131":6,"\ub9e4\ub825\ub3c4":6,"\uc7ac\ubbf8":6,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":6},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],SCORE_CREATIVE:[{"\ud45c\ud604\ub825":6,"\uc815\ubcf4\uc131":6,"\ub9e4\ub825\ub3c4":6,"\uc7ac\ubbf8":6,"\uc601\uc0c1\ubbf8":6,"\ub3c5\ucc3d\uc131":10},{"\ud45c\ud604\ub825":10,"\uc815\ubcf4\uc131":10,"\ub9e4\ub825\ub3c4":10,"\uc7ac\ubbf8":10,"\uc601\uc0c1\ubbf8":10,"\ub3c5\ucc3d\uc131":10}],G6_TITLE:'G6',G6_CONTENT_1:'\ub9cc\uc758 \ud2b9\ud654\ub41c \ub2a5\ub825\uce58 \uc810\uc218 \ud3c9\uac00 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4.',G6_CONTENT_2:'\uadf8\ub808\uc774\ub354\uc758 \ub9ac\ubdf0 \uc601\uc0c1\uc744 6\uac1c\uc758 \ub2a5\ub825\uce58\ub85c \uc138\ubd84\ud654\ud558\uc5ec \uc810\uc218\ub97c \ud3c9\uac00\ud568\uc73c\ub85c\uc368 \uc0ac\uc6a9\uc790\ub4e4\uc774 \uadf8\ub808\uc774\ub354 \uac1c\uac1c\uc778\uc758 \ub2a5\ub825\uce58\ub97c \uc9c1\uc811 \ubd84\uc11d\ud560 \uc218 \uc788\uc73c\uba70 \ub9ac\ubdf0\uc5b4\uc5d0 \ub300\ud55c \uc2e0\ub8b0\uc131\uc744 \uc99d\ud3ed\uc2dc\ud0a4\uace0\uc790 \ub3c4\uc785\ud55c greyd\ub9cc\uc758 \ud575\uc2ec \uae30\ub2a5\uc785\ub2c8\ub2e4.',G6_CONTENT_3:'G6\ub294 \uadf8\ub808\uc774\ub354\ub4e4\uc774 \uc62c\ub9b0 \uc601\uc0c1\uc5d0 \ub300\ud55c \uc131\uc801\ud45c\uc774\uc790 \uadf8\ub4e4\uc758 \ud2f0\uc5b4\ub97c \uacb0\uc815\ud558\ub294 \ub9e4\uc6b0 \uc911\uc694\ud55c \uc694\uc18c\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4.',AUTHENTIC_DESCRIPTION:'\uadf8\ub808\uc774\ub354\uac00 \uc81c\ud488\uc5d0 \ub300\ud55c \ub9ac\ubdf0\ub97c \uc5bc\ub9c8\ub098 \uba85\ud655\ud558\uace0 \uc27d\uac8c \ud480\uc5b4\ub0b4\ub294\uc9c0\ub97c \ub098\ud0c0\ub0b4\ub294 \ub2a5\ub825\uce58\uc785\ub2c8\ub2e4. \uc5b4\ud718\ub825, \ubb38\uc7a5\uad6c\uc0ac\ub825, \ubaa9\uc18c\ub9ac \ud06c\uae30, \ud1a4, \uc5b5\uc591, \ubc1c\uc74c, \uc18d\ub3c4, \uc81c\uc2a4\ucc98 \ub4f1\uc774 \uc774\uc5d0 \ud574\ub2f9\ub429\ub2c8\ub2e4.',INFORMATIVE_DESCRIPTION:'\uadf8\ub808\uc774\ub354\uac00 \uc5bc\ub9c8\ub098 \ub9ce\uc740 \uc591\uc758 \uc815\ubcf4\ub97c \ud6a8\uc728\uc801\uc73c\ub85c \uc804\ub2ec\ud558\ub294\uc9c0\ub97c \ub098\ud0c0\ub0b4\ub294 \ub2a5\ub825\uce58\uc785\ub2c8\ub2e4. \uc81c\ud488\uc5d0 \ub300\ud55c \uad6c\uccb4\uc801\uc778 \uc124\uba85(\uc81c\ud488\uba85, \uad6c\ub9e4 \uc2dc\uae30, \uac00\uaca9, \uc131\ub2a5, \ub514\uc790\uc778, \uc7a5\ub2e8\uc810 \ub4f1)\uc774 \uc774\uc5d0 \ud574\ub2f9\ub418\uba70 \ub9ac\ubdf0 \uc601\uc0c1\uc758 \uac00\uc7a5 \uc8fc\ub41c \ubaa9\uc801\uc774\uc790 \uc774\uc720\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4.',ATTRACTIVE_DESCRIPTION:'\uadf8\ub808\uc774\ub354\uac00 \ubcf4\ub294 \uc774\ub4e4\uc758 \ub9c8\uc74c\uc744 \uc2dc\uac01\uc801/\uc5b8\uc5b4\uc801\uc73c\ub85c \uc5bc\ub9c8\ub098 \uc0ac\ub85c\uc7a1\uc558\ub294\uc9c0, \ub610 \uad00\uc2ec\uc744 \uc720\ubc1c\ud588\ub294\uc9c0\ub97c \ub098\ud0c0\ub0b4\ub294 \ub2a5\ub825\uce58\uc785\ub2c8\ub2e4. \uadf8\ub808\uc774\ub354\uc758 \uc678\ubaa8, \uc2a4\ud0c0\uc77c, \ubd84\uc704\uae30, \uc131\ud5a5, \ub9d0\ud22c \ub4f1\uc774 \uc774\uc5d0 \ud574\ub2f9\ub429\ub2c8\ub2e4. \ud574\ub2f9 \ub2a5\ub825\uce58\uc758 \uc815\ub3c4\ub294 \ubcf4\ub294\uc774\ub9c8\ub2e4 \uae30\uc900\uc774 \uc0c1\uc774\ud558\ubbc0\ub85c \uac1c\ubcc4 \ucc28\uac00 \ud06c\uace0 \uc791\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',ENTERTAINING_DESCRIPTION:'\uadf8\ub808\uc774\ub354\uac00 \uc81c\ud488\uc758 \ub9ac\ubdf0 \uc601\uc0c1\uc744 \uc5bc\ub9c8\ub098 \ud765\ubbf8\ub86d\uace0 \uc990\uac81\uac8c \ud480\uc5b4\ub0b4\ub294\uc9c0\ub97c \ub098\ud0c0\ub0b4\ub294 \ub2a5\ub825\uce58\uc785\ub2c8\ub2e4. \ud589\ubcf5, \uc990\uac70\uc6c0\uc774 \uc774\uc5d0 \ud574\ub2f9\ub418\uba70 \ubcf4\ub294 \uc774\uc758 \uae30\ubd84\uacfc \uac10\uc815\uc744 \uc6c0\uc9c1\uc774\uae30\uc5d0 \uac00\uc7a5 \uc26c\uc6b4 \ub2a5\ub825\uce58\uc774\uae30\ub3c4 \ud569\ub2c8\ub2e4.  ',AESTHETIC_DESCRIPTION:'\uadf8\ub808\uc774\ub4dc\uac00 \uc81c\ud488\uc5d0 \ub300\ud55c \ub9ac\ubdf0\ub97c \uc5bc\ub9c8\ub098 \uc2dc\uac01\uc801\uc73c\ub85c \uc544\ub984\ub2f5\uac8c \ud480\uc5b4\ub0b4\ub294\uc9c0\ub97c \ub098\ud0c0\ub0b4\ub294 \ub2a5\ub825\uce58\uc785\ub2c8\ub2e4. \uc601\uc0c1 \uc18d\uc758 \uc870\uba85, \ubc30\uacbd, \uc5f0\ucd9c, \ud750\ub984, \ud6a8\uacfc, \uc0ac\uc6b4\ub4dc \ub4f1\uc774 \uc774\uc5d0 \ud574\ub2f9\ub429\ub2c8\ub2e4.',CREATIVE_DESCRIPTION:'\uadf8\ub808\uc774\ub354\uac00 \uc81c\ud488\uc5d0 \ub300\ud55c \ub9ac\ubdf0\ub97c \uc790\uc2e0\ub9cc\uc758 \uc2a4\ud0c0\uc77c\ub85c \uc5bc\ub9c8\ub098 \ucc3d\uc758\uc801\uc774\uace0 \uac1c\uc131 \uc788\uac8c \ud480\uc5b4\ub0b4\ub294\uc9c0\ub97c \ub098\ud0c0\ub0b4\ub294 \ub2a5\ub825\uce58\uc785\ub2c8\ub2e4. \uae30\uc874\uc5d0\ub294 \ubcf4\uc9c0 \ubabb\ud55c \uc2e0\ubc15\ud55c \ucee8\uc149\uc774\ub098 \ucf58\ud2f0\ub97c \ud1b5\ud574 \uc790\uc2e0\ub9cc\uc758 \uac1c\uc131\uc744 \uc0b4\ub824 \ucc3d\uc870\ud574\ub0b8 \ubb34\uc5b8\uac00\uac00 \uc774\uc5d0 \ud574\ub2f9\ub429\ub2c8\ub2e4.',WITHDRAWAL_INPUT_ERROR_TITLE:'\uc785\ub825 \uc624\ub958',WITHDRAWAL_INPUT_ERROR_CONTENT:'\uc22b\uc790\ub9cc \uc785\ub825\ud574\uc8fc\uc138\uc694',WITHDRAWAL_USER_CONTACT:'\uc5f0\ub77d\ucc98',WITHDRAWAL_USER_ID:'\uc2e0\ubd84\uc99d',WITHDRAWAL_USER_AGENCY_LICENSE:'\uc5d0\uc774\uc804\uc2dc \uc0ac\uc5c5\uc790\ub4f1\ub85d\uc99d',SHARE_QR_CODE:'QR Code \uacf5\uc720\ud558\uae30',GREYD_SIX:'\uadf8\ub808\uc774\ub4dc\uc2dd\uc2a4',UNREALIZED_REVENUE:'\uc801\ub9bd\uc608\uc815 \ub9ac\uc6cc\ub4dc',ORDER_CONFIRM:'\uad6c\ub9e4 \ud655\uc815',DEFAULT_NATION:'\ud55c\uad6d',USER_ID_DUPLICATED:'\uc544\uc774\ub514\uac00 \uc911\ubcf5\ub410\uc5b4\uc694.',POINT_TYPE:{REWARD:'\ud310\ub9e4 \ub9ac\uc6cc\ub4dc',EVENT_REWARD:'\uc774\ubca4\ud2b8 \ub9ac\uc6cc\ub4dc',WITHDRAWAL:'\ucd9c\uae08',REVIEW:'\ub9ac\ubdf0 \uc791\uc131',GRADE:'\ub9ac\ubdf0 \ud3c9\uac00',COMMENT:'\ub313\uae00 \uc791\uc131',ATTENDANCE:'\ucd9c\uc11d',DEDUCT:'\ub9ac\uc6cc\ub4dc \uc0ac\uc6a9',ROLLBACK:'\ub9ac\uc6cc\ub4dc \uc0ac\uc6a9 \ucde8\uc18c',CERTIFIED_REVIEWER_REWARD:'\uc778\uc99d \ub9ac\ubdf0\uc5b4 \ub9ac\uc6cc\ub4dc',BUY_REWARD:'\uad6c\ub9e4 \ub9ac\uc6cc\ub4dc'},REWARD_TYPE:'\ud3ec\uc778\ud2b8 \uc801\ub9bd \uc720\ud615',EXPIRED_DATE:'\ub9cc\ub8cc\uc77c',MY_REWARD:'\ub0b4 \ub9ac\uc6cc\ub4dc',GUEST_USER_ALERT_TITLE:'\ub85c\uadf8\uc778\ud558\ub7ec \uac00\uae30',GUEST_USER_ALERT_CONTENT:'\ud574\ub2f9 \uae30\ub2a5\uc740 \ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4',GUEST_LOGIN:'\ud68c\uc6d0\uac00\uc785 \uc5c6\uc774 \ub458\ub7ec\ubcf4\uae30',PLEASE_LOGIN:'\ub354 \ub9ce\uc740 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uae30 \uc704\ud574\uc11c\ub294 \ub85c\uadf8\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4',PAY_APP_NOT_INSTALLED:'\uc571\uc774 \uc124\uce58\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4',PAY_APP_INSTALL_SUGGEST:'\uc571\uc744 \uc124\uce58\ud560\uae4c\uc694?',HASH_TAG:'\ud574\uc2dc\ud0dc\uadf8',HASH_TAG_PLACE_HOLDER:'\ub744\uc5b4\uc4f0\uae30\ub97c \ud558\uba74 \ud574\uc2dc\ud0dc\uadf8\uac00 \ucd94\uac00\ub429\ub2c8\ub2e4',SEARCH_HASH_TAG_PLACE_HOLDER:'\uac80\uc0c9 (\ud574\uc2dc\ud0dc\uadf8\ub294 #\ub97c \ubd99\uc5ec\uc8fc\uc138\uc694)',TRUST_REVIEWER_AND_BUY:'\ub9ac\ubdf0\uc5b4 \ubbff\uace0 \uad6c\ub9e4\ud558\uae30',ABOUT_ME:'\uc790\uae30 \uc18c\uac1c',WRITE_ABOUT_ME:'\uc790\uae30\uc18c\uac1c\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc790\uae30\uc18c\uac1c\ub97c \uc791\uc131\ud574\uc8fc\uc138\uc694',QNA_HASHTAG_FIND_PLACE_HOLDER:'\ud0a4\uc6cc\ub4dc\ub97c \uac80\uc0c9\ud558\uac70\ub098 \uc9c8\ubb38\ud558\uc138\uc694',QNA_HASHTAG_LIST_SENTENCE:function(E){return`\uc720\uc800\ub4e4\uc774 ${E}\uc5d0\uac8c \ubb3c\uc5b4\ubcf8 \uc9c8\ubb38\uc774\uc5d0\uc694.`},QNA_HASHTAG_DELETE_TITLE:'Q&A \ud574\uc2dc\ud0dc\uadf8 \uc0ad\uc81c',QNA_HASHTAG_DELETE_MESSAGE:'\uc815\ub9d0 Q&A \uc8fc\uc81c\ub97c \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?',NEW_HASHTAG_CHAT_SEND:'\uc804\uc1a1',NEW_HASHTAG_PLACE_HOLDER:'\uc0c8\ub85c\uc6b4 \uc8fc\uc81c\ub97c \uc801\uc5b4\uc8fc\uc138\uc694',NEW_HASHTAG_EMPTY:'\uc8fc\uc81c\uac00 \ube44\uc5b4\uc788\uc2b5\ub2c8\ub2e4.',NEW_HASHTAG_DUPLICATED:'\uc911\ubcf5\ub41c \uc8fc\uc81c\uc785\ub2c8\ub2e4.',QNA_CHAT_DELETE_TITLE:'\uba54\uc2dc\uc9c0 \uc0ad\uc81c',QNA_CHAT_DELETE_MESSAGE:'\uc815\ub9d0 \ub300\ud654\ub0b4\uc5ed\uc744 \uc0ad\uc81c\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?',QNA_HASHTAG_CREATED_TITLE:function(E){return`${E.qnaAuthor}\ub2d8\uc774 Q&A\uc5d0 ${E.qnaHashtag}\ub97c \uc0dd\uc131\ud588\uc2b5\ub2c8\ub2e4.`},QNA_HASHTAG_CREATED_BODY:function(E){return`${E.qnaHashtag}`},QNA_CHAT_CREATED_TITLE:function(E){return`${E.qnaAuthor}\ub2d8\uc774 ${E.qnaHost}\uc758 #${E.qnaHashtag}\uc5d0 \uc0c8\ub85c\uc6b4 \uae00\uc744 \ub0a8\uacbc\uc2b5\ub2c8\ub2e4.`},QNA_CHAT_CREATED_BODY:function(E){return`${E.qnaChat}`},QNA_CHAT_MENTIONED_TITLE:function(E){return`${E.qnaAuthor}\ub2d8\uc774 ${E.qnaHost}\uc758 #${E.qnaHashtag}\uc5d0 \ub2f9\uc2e0\uc744 \uc5b8\uae09\ud558\uc600\uc2b5\ub2c8\ub2e4.`},QNA_CHAT_MENTIONED_BODY:function(E){return`${E.qnaChat}`},SAME_AS_ORDERER:'\uc8fc\ubb38\uc790 \uc815\ubcf4\uc640 \ub3d9\uc77c',PRODUCT_REMAINING_QUANTITY:function(E){return`\ub0a8\uc740 \uc218\ub7c9: ${E}\uac1c`},PROMOTION_PERIOD:'\ud504\ub85c\ubaa8\uc158 \uae30\uac04',QNA_PARTICIPANTS:'\ucc38\uc5ec\uc790',QNA_LEAVE:'\ub098\uac00\uae30',QNA_REFRESH:'\uc0c8\ub85c\uace0\uce68',QNA_HASHTAG_LIST_ME:'\ub0b4\uac00 \ud55c \uc9c8\ubb38',QNA_SHARE:function(E,_){return`${E}\uc758 #${_}\ub97c \ud655\uc778\ud558\uc138\uc694`},QNA_NOT_FOUND:'\uc9c8\ubb38\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.',SHALL_WE_CREATE_QNA:function(E){return`[#${E}]\ub85c \uc0c8 \uc9c8\ubb38\uc744 \uc0dd\uc131\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?`},QNA_FIND:'\uac80\uc0c9',QNA_CREATE:'\uc0dd\uc131',QNA_HASHTAG_DELETED:'\uc0ad\uc81c\ub41c Q&A \ud574\uc2dc\ud0dc\uadf8\uc785\ub2c8\ub2e4.',PURCHASE_ONLY_ONE_REFUND_PRODUCT:'\ud658\ubd88 \uc0c1\ud488\uc740 1\uac1c\ub9cc \uad6c\ub9e4\uac00\ub2a5\ud569\ub2c8\ub2e4.',PROMOTION_PERIOD_EXPIRED_TITLE:'\ud504\ub85c\ubaa8\uc158 \uae30\uac04 \ub9cc\ub8cc',PROMOTION_PERIOD_EXPIRED_CONTENT:function(E){return`\ud504\ub85c\ubaa8\uc158 \uae30\uac04\uc774 \uc885\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4 ~${E}`},REFUND_EVENT_PRODUCT:'100% \ud658\ubd88 \ub9ac\ubdf0 \uc774\ubca4\ud2b8',PROMOTION_PERIOD_NOT_STARTED_YET_TITLE:'\ud504\ub85c\ubaa8\uc158 \uae30\uac04\uc774 \uc544\ub2d9\ub2c8\ub2e4.',PROMOTION_PERIOD_NOT_STARTED_YET_CONTENT:function(E){return`\ud504\ub85c\ubaa8\uc158\uc774 \uc544\uc9c1 \uc2dc\uc791\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. ${E}~`},ORDER_LIST:'\uc8fc\ubb38\ub0b4\uc5ed',INITIAL_GUIDE_TITLE_1:'\ub9ac\ubdf0\uc5d0 \uc810\uc218\uc8fc\ub294',INITIAL_GUIDE_TITLE_2:'\uc9c4\uc2ec \ub9ac\ubdf0 \uc571',INITIAL_GUIDE_CONTENT:'\uc5ec\ub7ec\ubd84\uc758 \ud3c9\uc810\uc73c\ub85c \n \uc2e0\ub8b0\ubc1b\ub294 \ud504\ub85c \ub9ac\ubdf0\uc5b4\uac00 \ud0c4\uc0dd\ud574\uc694.',INITIAL_GUIDE_BUTTON:'\uccab \ud3c9\uc810 \uc8fc\ub7ec \uac00\uae30',NON_DISPLAY_RATING_USER_REASON:'\ud3c9\uac00\uac00 8\uac1c \uc774\uc0c1 \ub418\uba74, \ud3c9\uac00\uc790 \ub9ac\uc2a4\ud2b8\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4.',INSUFFICIENT_REWARDS:'\uc0ac\uc6a9 \uac00\ub2a5 \ub9ac\uc6cc\ub4dc\uac00 \ubd80\uc871\ud569\ub2c8\ub2e4',ENTER_REWARD:'\uc0ac\uc6a9 \ud560 \ub9ac\uc6cc\ub4dc\ub97c \uc785\ub825\ud