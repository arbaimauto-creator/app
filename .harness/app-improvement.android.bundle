\ubdf0\uc5b4\uc5d0\uac8c \ub3cc\uc544\uac11\ub2c8\ub2e4.',REVENUE_GUIDE_TITLE_2:'\uc218\uc775\uae08\uc740 \uc5b8\uc81c\ub4e0\uc9c0 \ubc14\ub85c \ucd9c\uae08',REVENUE_GUIDE_BODY_2_1:'\uad6c\ub9e4\uc790\uac00 [\uad6c\ub9e4\ud655\uc815] \uc644\ub8cc \uc2dc, \ub9ac\ubdf0\uc5b4\uc758 \uc218\uc775\uc744 \uc815\uc0b0\ud574\ub4dc\ub9bd\ub2c8\ub2e4. \uc774\ub807\uac8c \uc62c\ub824\uc9c4 \uc218\uc775\uc740 \uacc4\uc88c\ub85c \uc774\uccb4\ud574\ub4dc\ub9bd\ub2c8\ub2e4.',REVENUE_GUIDE_TITLE_3:'\uadf8\ub808\uc774\ub4dc\uc5d0 \ub9ac\ubdf0\ub97c \uc62c\ub824\uc57c\ud558\ub294 \uc774\uc720',REVENUE_GUIDE_BODY_3_1:'\uc9c4\uc9dc \ub9ac\ubdf0\ub85c \ucc44\uc6cc\uc9c0\ub294 \ubbff\uc744 \uc218 \uc788\ub294 \ud50c\ub7ab\ud3fc, \uc2e4\uc0ac\uc6a9 \ud6c4 \uc62c\ub9ac\ub294 \uc194\uc9c1\ud55c \ub9ac\ubdf0\ub4e4\uc774 \ubaa8\uc785\ub2c8\ub2e4. ',REVENUE_GUIDE_BODY_3_2:'\ud314\ub85c\uc6cc\uac00 \uc5c6\uc5b4\ub3c4 \uc8fc\ubaa9\ubc1b\uc744 \uc218 \uc788\uc5b4\uc694. \uadf8\ub808\uc774\ub4dc\uc758 \uc54c\uace0\ub9ac\uc998\uc740 \uc88b\uc740 \ub9ac\ubdf0\uac00 \ub178\ucd9c\ub420 \uc218 \uc788\ub3c4\ub85d \uc720\uc6a9\ud558\uace0 \uc2e0\ub8b0\ud560 \uc218 \uc788\ub294 \ucf58\ud150\uce20\uc5d0 \uc9d1\uc911\ud569\ub2c8\ub2e4.',REVENUE_GUIDE_BODY_3_3:'\ub9ac\ubdf0\ub3c4 \uc62c\ub9ac\uace0 \uc218\uc775\ub3c4 \uc62c\ub9ac\uc138\uc694. \uc62c\ub824\uc8fc\uc2e0 \ub9ac\ubdf0\ub97c \ud1b5\ud574 \uc218\uc775\ub3c4 \uc62c\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',REVENUE_GUIDE_BODY_3_4:'\uc88b\uc740 \uc0c1\ud488\uc744 \uc800\ub834\ud55c \uac00\uaca9\uc5d0 \ub9cc\ub098\uc138\uc694. \uadf8\ub808\uc774\ub4dc\ud300\uc758 \uc804\ubb38MD\uac00 \uc120\uc815\ud55c \uace0\ud004\ub9ac\ud2f0 \uc0c1\ud488\uc744 \ud569\ub9ac\uc801\uc778 \uac00\uaca9\uc5d0 \uc81c\uacf5\ud569\ub2c8\ub2e4.',GRADE_GIVING_GUIDE:function(E){return`\uc720\uc6a9\ud55c \ub9ac\ubdf0\uc600\ub098\uc694?\n\uc774 \ub9ac\ubdf0\uc5d0 ${E.userName}\ub2d8\uc758 \uc810\uc218\ub97c \ub0a8\uaca8\uc8fc\uc138\uc694.`},GRADING_GUIDE_TITLE:'\ub9ac\ubdf0\uc5d0 \ub300\ud55c \ub098\uc758 \uc758\uacac\uc744 \uc810\uc218\ub85c \ud45c\ud604\ud574\uc8fc\uc138\uc694.',GRADING_GUIDE_BODY_1:'\uadf8\ub808\uc774\ub4dc\uc5d0\uc11c\ub294 1\uc810\ubd80\ud130 10\uc810\uae4c\uc9c0 \uc810\uc218\ub97c \uc904 \uc218 \uc788\uc5b4\uc694.',GRADING_GUIDE_BODY_2:'\ub192\uc740 \uc810\uc218\ub97c \ubc1b\uc740 \ub9ac\ubdf0\ub294 \ub354 \ub9ce\uc740 \ub178\ucd9c \uae30\ud68c\ub97c \uc5bb\uc5b4\uc694.',GRADING_GUIDE_BODY_3:'\uc810\uc218\ub97c \ud1b5\ud574 \ub9ac\ubdf0\uc758 \uc2e0\ub8b0\uc131\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc5b4\uc694.',GRADING_GUIDE_WARNING:'\uc810\uc218\ub97c \uc8fc\uc2e0 \uc774\ud6c4\uc5d0\ub294 \uc0ac\ub77c\uc9c0\ub294 \uba54\uc138\uc9c0\uc785\ub2c8\ub2e4.',TUTORIAL_LANDING_TITLE_1:'\uadf8\ub808\uc774\ub4dc\uc5d0\uc11c\ub294 \ub2e4 \uac00\ub2a5\ud574\uc694.',TUTORIAL_LANDING_TITLE_2:'\ub9ac\ubdf0\ub97c \uc62c\ub9ac\uac70\ub098,\n\ub9ac\ubdf0\ub97c \ud3c9\uac00\ud574\ubcf4\uc138\uc694.',TUTORIAL_LANDING_TITLE_3:'\ub2e4\ub978 \uc0ac\ub78c\ub4e4\uc740\n\uc5b4\ub5a4 \ubb3c\uac74\uc744 \uc0c0\uc744\uae4c?',TUTORIAL_LANDING_TITLE_4:'\uadf8\ub808\uc774\ub4dc\uc5d0\uc11c\n\ub2f9\uc2e0\uc758 \ub9ac\ubdf0\ub97c \ud30c\uc138\uc694.\n\uc9c4\uc9dc \ub9ac\ubdf0,\n\uadf8\ub808\uc774\ub4dc\uc785\ub2c8\ub2e4. ',TUTORIAL_LANDING_BODY_1:'\ub9ac\ubdf0\ub97c \uc62c\ub9ac\uace0 \uc218\uc775\uc744 \ucc3d\ucd9c\ud558\ub294 \ub9ac\ubdf0\uc5b4/\n\uadf8\ub7f0 \ub9ac\ubdf0\uc5b4\ub97c \uc9c0\uc9c0\ud558\ub294 \ud314\ub85c\uc6cc\n\ubaa8\ub450 \uac00\ub2a5\ud569\ub2c8\ub2e4.',TUTORIAL_LANDING_BODY_2:'\uadf8\ub808\uc774\ub4dc\uc758 \ub9ac\ubdf0\ubb38\ud654\ub294\n\uc6b0\ub9ac \ubaa8\ub450\uac00 \ub9cc\ub4e4\uc5b4\uac11\ub2c8\ub2e4.',TUTORIAL_LANDING_BODY_3:'\ub9c8\uc774\ud398\uc774\uc9c0\uc5d0\uc11c \ub2e4\ub978 \uc720\uc800\ub4e4\uc774\n\ucd5c\uadfc\uc5d0 \uc0b0 \ubb3c\uac74\uc744 \ubcfc \uc218 \uc788\uc5b4\uc694.',TUTORIAL_LANDING_BODY_4:'\uadf8\ub808\uc774\ub4dc \uc811\uc18d\ud558\uae30',TUTORIAL_REVIEW_TITLE_5:'\ub9ac\ubdf0\ub294\n\uc5b8\uc81c\ub098\n