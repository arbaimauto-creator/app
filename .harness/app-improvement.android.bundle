94',PURCHASE_RULE_BUTTON_LABEL:'\ubc30\uc1a1/\uad50\ud658/\ubc18\ud488 \uc815\ubcf4',VIEW_COUNT:function(E){return`\uc870\ud68c\uc218 ${E}`},MONEY_AMOUNT_UNIT_DOLLOR:function(E){return`$${E}`},MONEY_AMOUNT_UNIT_WON:function(E){return`${E}\uc6d0`},HOT_REVIEWER:'\ub728\uace0 \uc788\ub294 \ub9ac\ubdf0\uc5b4',FOLLOWER_COUNT:function(E){return`${E} \ud314\ub85c\uc6cc`},FOLLOWING_COUNT:function(E){return`${E} \ud314\ub85c\uc789`},MYPROFILE_SCREEN_TITLE:'\ub9c8\uc774 \ud504\ub85c\ud544',UPPER_REVIEW:'\uc0c1\uc704 \ub9ac\ubdf0',SECONDS_AGO:function(E){return'\ubc29\uae08'},MINUTES_AGO:function(E){return`${E}\ubd84 \uc804`},HOURS_AGO:function(E){return`${E}\uc2dc\uac04 \uc804`},DAYS_AGO:function(E){return`${E}\uc77c \uc804`},MONTHS_AGO:function(E){return`${E}\ub2ec \uc804`},YEARS_AGO:function(E){return`${E}\ub144 \uc804`},BUY:'\uad6c\ub9e4\ud558\uae30',REVIEWS_FOR_PRODUCT:'\uc0c1\ud488\uc758 \ub2e4\ub978 \ub9ac\ubdf0',UNCATEGORIZED:'\ubbf8\ubd84\ub958',SELLER_BANK_NAME:'\uc740\ud589\uba85',SELLER_BANK_ACCOUNT:'\uacc4\uc88c\ubc88\ud638',SELLER_BANK_ACCOUNT_HOLDER:'\uc608\uae08\uc8fc',GRADING_REVIEW:'\ub9ac\ubdf0 \uadf8\ub808\uc774\ub4dc',REVIEW_LIST:'\ub9ac\ubdf0 \ubaa9\ub85d',PRODUCT_LIST:'\uc0c1\ud488 \ubaa9\ub85d',EXCHANGE_AND_RETURN:'\uad50\ud658/\ud658\ubd88',EXCHANGE_AND_RETURN_PERIOD:'\uad50\ud658/\ud658\ubd88 \uac00\ub2a5 \uae30\uac04',EXCHANGE_AND_RETURN_PERIOD_DESCRIPTION:'\uad50\ud658/\ud658\ubd88 \uc694\uccad\uc740 \ubc30\uc1a1 \uc644\ub8cc \uc2dc\uc810\uc73c\ub85c\ubd80\ud130 7\uc77c \uc774\ub0b4\uc5d0 \uac00\ub2a5\ud569\ub2c8\ub2e4. (\ub2e8, \uc218\ub839\ud55c \uc0c1\ud488\uc774 \ud45c\uae30 \uad11\uace0\uc758 \ub0b4\uc6a9\uacfc \ub2e4\ub974\uac70\ub098 \uacc4\uc57d \ub0b4\uc6a9\uacfc \ub2e4\ub974\uac8c \uc774\ud589\ub41c \uacbd\uc6b0\uc5d0\ub294 \uc218\ub839\ud55c \ub0a0\ub85c\ubd80\ud130 3\uac1c\uc6d4 \uc774\ub0b4, \uadf8 \uc0ac\uc2e4\uc744 \uc54c \uc218 \uc788\uc5c8\ub358 \ub0a0\ub85c\ubd80\ud130 30\uc77c \uc774\ub0b4\uc5d0\ub294 \uad50\ud658/\ud658\ubd88 \uc2e0\uccad \uac00\ub2a5\ud569\ub2c8\ub2e4.)',HOW_TO_EXCHANGE_AND_RETURN:'\uad50\ud658/\ud658\ubd88 \uc694\uccad \ubc29\ubc95',HOW_TO_EXCHANGE_AND_RETURN_DESCRIPTION:'\uad50\ud658 \n1) \uc7a5\ubc14\uad6c\ub2c8 > \ubc30\uc1a1\uc644\ub8cc \ud398\uc774\uc9c0\uc5d0\uc11c \uad50\ud658 \uc694\uccad \n2) \ud0dd\ubc30\uae30\uc0ac \ubc18\ud488 \uc0c1\ud488 \uc218\uac70(\uc77c\ubd80 \ud654\ubd88/\uc124\uce58 \uc0c1\ud488 \uc81c\uc678) OR \ud3b8\uc758\uc810\uc5d0\uc11c \ubc18\ud488 \uc811\uc218 \n- \ud0dd\ubc30\ubc18\ud488: \ud658\ubd88 \uc694\uccad \ud6c4 1~3\uc77c \uc774\ub0b4(\uc8fc\ub9d0/\uacf5\ud734\uc77c \uc81c\uc678)\uc5d0 \uc9c0\uc815 \ud0dd\ubc30\uc0ac \uc9c1\uc6d0 \ub610\ub294 \ud574\ub2f9 \ud310\ub9e4\uc5c5\uccb4\uc5d0\uc11c \uc9c1\uc811 \uc218\uac70\ud569\ub2c8\ub2e4. \n- \ud3b8\uc758\uc810\ubc18\ud488: \uac00\uae4c\uc6b4 \ud3b8\uc758\uc810 (CU, GS25)\uc5d0 \ubc29\ubb38\ud558\uc154\uc11c \uc9c1\uc811 \uc811\uc218\ud574\uc8fc\uc138\uc694. \n3) \uc0c8\uc0c1\ud488 \uc7ac\ubc30\uc1a1 \n\n\ud658\ubd88 \n1) \uc7a5\ubc14\uad6c\ub2c8 > \ubc30\uc1a1\uc644\ub8cc \ud398\uc774\uc9c0\uc5d0\uc11c \ud658\ubd88 \uc694\uccad \n2) \ud0dd\ubc30\uae30\uc0ac \ubc18\ud488 \uc0c1\ud488 \uc218\uac70(\uc77c\ubd80 \ud654\ubd88/\uc124\uce58 \uc0c1\ud488 \uc81c\uc678) OR \ud3b8\uc758\uc810\uc5d0\uc11c \ubc18\ud488 \uc811\uc218 \n- \ud0dd\ubc30\ubc18\ud488: \ud658\ubd88 \uc694\uccad \ud6c4 1~3\uc77c \uc774\ub0b4(\uc8fc\ub9d0/\uacf5\ud734\uc77c \uc81c\uc678)\uc5d0 \uc9c0\uc815 \ud0dd\ubc30\uc0ac \uc9c1\uc6d0 \ub610\ub294 \ud574\ub2f9 \ud310\ub9e4\uc5c5\uccb4\uc5d0\uc11c \uc9c1\uc811 \uc218\uac70\ud569\ub2c8\ub2e4. \n- \ud3b8\uc758\uc810\ubc18\ud488: \uac00\uae4c\uc6b4 \ud3b8\uc758\uc810 (CU, GS25)\uc5d0 \ubc29\ubb38\ud558\uc154\uc11c \uc9c1\uc811 \uc811\uc218\ud574\uc8fc\uc138\uc694. \n3) \ud658\ubd88 \ucc98\ub9ac',EXCHANGE_AND_RETURN_SHIPMENT_FEE:'\ubc18\ud488\ubc30\uc1a1\ube44',EXCHANGE_AND_RETURN_SHIPMENT_FEE_DESCRIPTION:'\uad50\ud658 \n5,000\uc6d0 \n\ub3d9\uc77c\uc0c1\ud488 \ubc0f \ub3d9\uc77c \uc635\uc158\uc73c\ub85c\ub9cc \uad50\ud658\uc774 \uac00\ub2a5\ud558\uba70, \ud310\ub9e4\uc790\uadc0\ucc45(\uc81c\ud488\ud558\uc790, \uc624\ubc30\uc1a1 \ub4f1)\uc73c\ub85c \uc694\uccad\ud558\uc168\ub354\ub77c\ub3c4 \uc0c1\ud488\ud655\uc778 \uacb0\uacfc\uc5d0 \ub530\ub77c \ubc30\uc1a1\ube44 \uc785\uae08\uc744 \uc694\uccad\ub4dc\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub3c4\uc11c \uc0b0\uac04 \uc9c0\uc5ed \ubc0f \uc124\uce58/\ud574\uc678 \ubc30\uc1a1 \uc0c1\ud488\uc740 \ucd94\uac00 \ube44\uc6a9\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\n\ud658\ubd88 \n\uc655\ubcf5 5,000\uc6d0 \n\uace0\uac1d \ub2e8\uc21c \ubcc0\uc2ec\uc758 \uacbd\uc6b0\uc5d0\ub9cc \ubc1c\uc0dd\ub418\uba70, \ucd5c\ucd08 \ubc30\uc1a1\ube44 \ubb34\ub8cc\uc778 \uacbd\uc6b0 \uc655\ubcf5\ubc30\uc1a1\ube44 \ucc28\uac10 \ud6c4 \ud658\ubd88\ub429\ub2c8\ub2e4. \n\ub3c4\uc11c \uc0b0\uac04 \uc9c0\uc5ed \ubc0f \uc124\uce58/\ud574\uc678 \ubc30\uc1a1 \uc0c1\ud488\uc740 \ucd94\uac00 \ube44\uc6a9\uc774 \ubc1c\uc0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',SNS_SIGN_IN:'SNS\ub85c \ub85c\uadf8\uc778 \ud558\uae30',ARBAIM_INC:'ARBAIM INC.',SURE_TO_CONFIRM_PURCHASE:'\uad6c\ub9e4\ub97c \ud655\uc815\ud558\uc2dc\uaca0\uc2b5\ub2c8\uae4c?',REQUEST_PERMISSION:'\uad8c\ud55c \uc694\uccad',PERMISSION_GALLERY_MESSAGE:'\uc774\ubbf8\uc9c0 \ubc0f \uc601\uc0c1 \uc5c5\ub85c\ub4dc\ub97c \uc704\ud574 \uac24\ub7ec\ub9ac \uc811\uadfc \uad8c\ud55c\uc774 \ud544\uc694\ud569\ub2c8\ub2e4.',REJECTED_PERMISSION_GALLERY_MESSAGE:'\uac24\ub7ec\ub9ac \uc811\uadfc \uad8c\ud55c\uc774 \uac70\ubd80\ub418\uc5b4 \ud574\ub2f9 \uae30\ub2a5\uc744 \uc774\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub514\ubc14\uc774\uc2a4\uc758 \uc571 \uc124\uc815\uc5d0\uc11c \uad8c\ud55c \uc124\uc815\uc744 \ubcc0\uacbd\ud574\uc8fc\uc138\uc694.',YES:'\ub124',NO:'\uc544\ub2c8\uc624',TEXT_DESCRIPTION:'\uc0c1\ud488 \uc0c1\uc138 \uc124\uba85',IMAGE_DESCRIPTION:'\uc0c1\ud488 \uc124\uba85 \uc774\ubbf8\uc9c0',PRODUCT_IMAGE:'\uc0c1\ud488 \uc774\ubbf8\uc9c0',SHIPMENT_COST:'\ubc30\uc1a1\ube44',LOWEST_ORDER_PRICE_FOR_FREE_DELIVERY:'\ubb34\ub8cc\ubc30\uc1a1 \ucd5c\uc18c \uc8fc\ubb38\uae08\uc561',CHECKING_UPDATE:'\uc5c5\ub370\uc774\ud2b8\ub97c \ud655\uc778\uc911\uc785\ub2c8\ub2e4.',ONBOARING_1_TITLE:'\uc0c1\ud488 \uacbd\ud5d8\uc758 \uacf5\uc720',ONBOARING_1_MESSAGE:'\uc0c1\ud488\uc744 \uc368\ubcf8 \uc0ac\ub78c\ub4e4\uc758\n \uc194\uc9c1\ud55c \ub9ac\ubdf0\ub97c \uacbd\ud5d8 \ud574 \ubcf4\uc138\uc694',ONBOARING_2_TITLE:'\uc0c1\ud488 \uc815\ubcf4 \ud655\uc778',ONBOARING_2_MESSAGE:'\ub9ac\ubdf0\uc5d0 \ub9c1\ud06c\ub41c \uc0c1\ud488\uc744 \ud655\uc778\ud558\uace0\n \uad6c\ub9e4\ub3c4 \uac00\ub2a5\ud569\ub2c8\ub2e4',ONBOARING_3_TITLE:'\ub0b4 \uacbd\ud5d8\uc774 \uc218\uc775\uc73c\ub85c',ONBOARING_3_MESSAGE:'\ub0b4 \ub9ac\ubdf0\ub85c \ub204\uad70\uac00\uc758 \uad6c\ub9e4\uc5d0\n \ub3c4\uc6c0\uc774 \ub418\uc5c8\ub2e4\uba74 \uc218\uc775\uc744 \ub0bc\uc218 \uc788\uc5b4\uc694',START:'\uc2dc\uc791\ud558\uae30',UPLOAD_VIDEO:'\ub9ac\ubdf0 \uc601\uc0c1 \uc5c5\ub85c\ub4dc',PLEASE_ADD_EXTERNAL_PRODUCT_LINK:'\uac80\uc0c9\uacb0\uacfc\uac00 \uc5c6\uc744\uacbd\uc6b0\n \uc678\ubd80 \ub9c1\ud06c\ub97c \uc9c1\uc811 \ub4f1\ub85d\ud574\uc8fc\uc138\uc694',NO_PRODUCT_SEARCH_RESULT:function(E){return`\u201c${E}\u201d\uc5d0 \ub300\ud55c \uacb0\uacfc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4.\n \uadf8\ub808\uc774\ub4dc \uc0c1\ud488\uc774 \uc544\ub2cc \uacbd\uc6b0,\n \uc0c1\ud488\uc758 \ub9c1\ud06c\ub97c \uc9c1\uc811 \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.`},NEW_EXTERNAL_PRODUCT_LINK:'\ub9c1\ud06c \ub4f1\ub85d',VALIDATION_MESSAGE_NO_LINK_URL:'\uc0c1\ud488 \ub9c1\ud06c\ub97c \uc785\ub825\ud574\uc8fc\uc138\uc694.',LINK_THIS_PRODUCT:'\ud574\ub2f9 \uc0c1\ud488 \uc5f0\uacb0',DELETE_VIDEO:'\uc601\uc0c1 \uc0ad\uc81c',CHANGE_PROFILE_IMAGE:'\ud504\ub85c\ud544 \uc0ac\uc9c4 \ubcc0\uacbd',INPUT_SELLER_BANK_NAME:'\uc740\ud589\uba85 \uc785\ub825',INPUT_SELLER_BANK_ACCOUNT:'\uacc4\uc88c\ubc88\ud638 \uc785\ub825',INPUT_SELLER_BANK_ACCOUNT_NAME:'\uc608\uae08\uc8fc \uc785\ub825',SET_PROFILE:'\ud504\ub85c\ud544 \uc124\uc815',SIGN_UP:'\ud68c\uc6d0 \uac00\uc785',CHOOSE_PRODUCT:'\uc0c1\ud488 \uc120\ud0dd',BUY_NOW:'\ubc14\ub85c \uad6c\ub9e4',ADDITIONAL_PRODUCT:'\ucd94\uac00 \uc0c1\ud488',EXPECTED_PRICE:'\uacb0\uc81c\uc608\uc815\uae08\uc561',TOTAL_PRODUCT_PRICE:'\ucd1d \uc0c1\ud488 \uae08\uc561',PRODUCT_DETAIL:'\uc8fc\ubb38 \uc0c1\ud488',ORDERER_INFO:'\uc8fc\ubb38\uc790 \uc815\ubcf4',SHIPPING_INFO:'\ubc30\uc1a1 \uc815\ubcf4',ORDER_AMOUNT:'\uc8fc\ubb38 \uae08\uc561',TOTAL_PRICE:'\ucd5c\uc885 \uacb0\uc81c \uae08\uc561',PROCEED_TO_PAY:function(E){return`${E} \uacb0\uc81c`},PURCHASE_CANCELED:'\uad6c\ub9e4 \ucde8\uc18c\ub428',ORDER_DETAIL:'\uc8fc\ubb38\ub0b4\uc5ed \uc0c1\uc138',FAILED_TO_PAY:'\uacb0\uc81c\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4.',FAILED_TO_GET_PAYMENT_INFO:'\uacb0\uc81c \uc815\ubcf4 \ud655\uc778\uc5d0 \uc2e4\ud328\ud588\uc2b5\ub2c8\ub2e4.',ORDER_DATE:'\uc8fc\ubb38\uc77c\uc790',PAYMENT_INFO:'\uacb0\uc81c \uc815\ubcf4',ORDERER_NAME:'\uc8fc\ubb38\uc790',RECEIVER_NAME:'\ubc1b\ub294 \ubd84',REVIEW_REWARDS:'\ub9ac\uc6cc\ub4dc',TOTAL_REWARDS:'\ucd1d \ub9ac\uc6cc\ub4dc \uae08\uc561',CONTRIBUTED_SALES:'\uae30\uc5ec \ub9e4\ucd9c\uc561',REWARD_AMOUNT:'\ub9ac\uc6cc\ub4dc',TOTAL_SALES_AMOUNT:'\ucd1d \ub9e4\ucd9c\uc561',SALES_LIST:'\ub9e4\ucd9c \ub0b4\uc5ed',TOTAL_REVENUES:'\ucd1d \ub9e4\ucd9c',TOTAL_CONTRIBUTED_SALES:'\ucd1d \uae30\uc5ec \ub9e4\ucd9c\uc561',REVIEW:'\ub9ac\ubdf0',REVENUES:'\ub9e4\ucd9c',REVENUE_BUYER:'\uad6c\ub9e4\uc790',REVENUE_SETTLEMENT:'\ub9e4\ucd9c \uc815\uc0b0',PLATFORM_COMMISSION:'\ud50c\ub7ab\ud3fc \uc218\uc218\ub8cc',PAYMENT_COMMISSION:'\uacb0\uc81c \uc218\uc218\ub8cc',REVENUE:'\ub9e4\ucd9c\uc561',HELP:'\ub3c4\uc6c0\ub9d0',BUSINESS_NAME:'\uc0c1\ud638\uba85',BUSINESS_NAME_ARBAIM:'(\uc8fc)\uc54c\ubc14\uc784',CEO:'\ub300\ud45c\uc790',CEO_ARBAIM:'Seol Ryan Hyungeu',CONTACT:'\ubb38\uc758 \uc5f0\ub77d\ucc98',CONTACT_ARBAIM:'info@arbaim.com',ADDRESS_ARBAIM:'\uc11c\uc6b8 \uac15\ub0a8\uad6c \ud559\ub3d9\ub85c 212 post ville, 311\ud638',SELECT_R