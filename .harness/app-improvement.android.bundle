se`},FGI_MIN_TEXT:function(E){return`Please write at least ${E} characters each for pros & cons. Specific answers count toward your quality bonus.`},FI_TITLE:'30-second first impression',FI_SUB:function(E){return`Just opened it? This exact moment is what ${E} values most.`},FI_UNBOXING:'Unboxing (packaging & contents)',FI_FIRST_USE:'First feel in use',FI_NOTE_LABEL:'One line (optional)',FI_NOTE_PH:'e.g. The scent was subtler than I expected',FI_SUBMIT:'Save',FI_SKIP:'Maybe later',FGI_SUBMIT:'Submit survey',FGI_DONE_TITLE:'Survey done!',FGI_DONE_BODY:'Now upload your review video',REVIEW_SUBMIT_TITLE:'Upload review',REVIEW_SUBMIT_MUST_MENTION:function(E){return`Must mention: ${E}`},REVIEW_SUBMIT_LINK_LABEL:'Review link',REVIEW_SUBMIT_LINK_PLACEHOLDER:'instagram.com/reel/\u2026',REVIEW_SUBMIT_FORMAT_LABEL:'Format',REVIEW_SUBMIT_FORMAT_SHORT:'Short-form',REVIEW_SUBMIT_FORMAT_LONG:'Long-form',REVIEW_SUBMIT_FORMAT_IMAGE:'Image',REVIEW_SUBMIT_FORMAT_STORY:'Story',REVIEW_SUBMIT_HASHTAG_LABEL:'Hashtags',REVIEW_SUBMIT_COPY:'Copy \u29c9',REVIEW_SUBMIT_COPIED:'Hashtags copied',REVIEW_SUBMIT_CHECK_POINTS:function(E){return`I mentioned all ${E} required points in my review`},REVIEW_SUBMIT_CHECK_TAGGED:'I tagged the brand account (optional)',REVIEW_SUBMIT_FOOTNOTE:'Submitting starts the brand check \xb7 feedback arrives within 7 days',REVIEW_SUBMIT_CTA:'Upload complete',REVIEW_SUBMIT_INVALID_URL:'Please enter a valid review link (URL)',REVIEW_SUBMIT_INCOMPLETE:'Complete the link, format, and required checkbox',REVIEW_SUBMIT_DONE_TITLE:'Uploaded!',REVIEW_SUBMIT_DONE_BODY:'The brand check has started. Feedback arrives within 7 days.',BRAND_GAUGE_LABEL:'Overall appeal',BRAND_INTENT_LABEL:'Purchase intent',BRAND_FGI_SECTION:'FGI quantitative results',BRAND_GALLERY_SECTION:'UGC gallery',BRAND_HD_DOWNLOAD:'Request HD original',BRAND_HD_PENDING:'Your manager will deliver the original files.',CONCURRENT_LIMIT_ALERT:function(E){return`You can run ${E} campaign${E>1?'s':''} at a time. Finish an active review to apply.`},REM_MID_T:'Halfway to your deadline!',REM_MID_B:function(E){return`"${E}" \u2014 a 15-second unboxing counts \ud83c\udfac`},REM_D3_T:'3 days left',REM_D3_B:function(E){return`"${E}" \u2014 need more time? You can extend by 7 days`},REM_D1_T:'Due tomorrow',REM_D1_B:function(E){return`"${E}" \u2014 missing it costs your points and G-score`},REM_DUE_T:'Due today!',REM_DUE_B:function(E){return`"${E}" \u2014 upload within 48h and it still counts (points -30%)`},REM_GRACE_T:'Last chance',REM_GRACE_B:function(E){return`"${E}" \u2014 the grace window is closing. Upload now!`},BRAND_WELCOME_T:function(E){return"Welcome"+(E?', '+E:'')},BRAND_WELCOME_B:'ARBAIM runs everything \u2014 campaign setup, creator recruiting, shipping.\nYou just watch the results and score the reviews.',BRAND_WELCOME_1:'\ud83d\udcca  Dashboard \u2014 country signals & weekly findings',BRAND_WELCOME_2:'\u2705  Review \u2014 \ud83d\udc4d\ud83d\udc4c\ud83d\udc4e triage, then score the picks',BRAND_WELCOME_3:'\ud83d\udcc4  FGI report \u2014 delivered by your analyst after the campaign',BRAND_WELCOME_CTA:'Open dashboard',REFERRAL_INVITED_BY:function(E){return E?`Your name @${E} is on each code`:''},REFERRAL_SHARE_MESSAGE_NAMED:function(E,t){return`@${t} invited you to greyd \u2014 the invite-only panel where Korean brands actually read your review. Code: ${E}`},REFERRAL_TITLE:'3 invites unlocked',REFERRAL_NOTE:'Issued only to creators who completed their first review loop. Your name is on the code.',REFERRAL_SHARE_MESSAGE:function(E){return`You're invited to greyd \u2014 the invite-only panel where Korean brands actually read your review. Code: ${E}`},BRAND_TAB_DASH:'Dashboard',BRAND_TAB_REVIEW:'Review',BRAND_DASH_TITLE:'Campaign Dashboard',BRAND_REVIEW_TITLE:'Review & Score',BRAND_SUM_UPLOADS:'Uploads',BRAND_SUM_REACH:'Reach',BRAND_SUM_SCORE:'Avg score',BRAND_SUM_COUNTRIES:'Countries',BRAND_METRICS_MANUAL_NOTE:'Reach is manually collected 7 days after each upload',BRAND_WEE